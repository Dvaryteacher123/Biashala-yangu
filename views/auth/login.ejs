<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     LOGIN PAGE — Firebase Auth + Firestore (users/{uid})
     ========================================================== -->

<main class="auth-page">
  <div class="auth-card">

    <!-- ============ Kichwa ============ -->
    <div class="auth-head">
      <div class="auth-icon">🔑</div>
      <h1>Karibu Tena</h1>
      <p>Ingia kwenye akaunti yako ili kuendelea</p>
    </div>

    <!-- ============ Form ============ -->
    <form id="loginForm" class="auth-form" novalidate>

      <!-- Email -->
      <div class="field">
        <label for="email">Email *</label>
        <input
          type="email"
          id="email"
          placeholder="barua@mfano.com"
          autocomplete="email"
          required
        />
      </div>

      <!-- Password -->
      <div class="field">
        <label for="password">Password *</label>
        <div class="pw-wrap">
          <input
            type="password"
            id="password"
            placeholder="••••••••"
            autocomplete="current-password"
            required
          />
          <button type="button" class="pw-toggle" id="pwToggle" aria-label="Onyesha password">
            👁️
          </button>
        </div>
      </div>

      <!-- Remember + forgot -->
      <div class="form-row">
        <label class="check">
          <input type="checkbox" id="rememberMe" checked />
          <span>Nikumbuke</span>
        </label>
        <a href="/auth/forgot-password" class="link-small">Umesahau password?</a>
      </div>

      <!-- Message -->
      <p id="loginMsg" class="alert" style="display:none;"></p>

      <!-- Submit -->
      <button type="submit" class="btn btn-primary btn-full btn-lg" id="loginBtn">
        Ingia
      </button>

    </form>

    <!-- ============ Divider ============ -->
    <div class="divider"><span>au</span></div>

    <!-- ============ Google Sign-in ============ -->
    <button class="btn-google" id="googleBtn" type="button">
      <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      Ingia kwa Google
    </button>

    <!-- ============ Footer ============ -->
    <p class="auth-footer">
      Hauna akaunti?
      <a href="/auth/signup<%= redirect && redirect !== '/' ? '?redirect=' + encodeURIComponent(redirect) : '' %>">
        Jiunge sasa
      </a>
    </p>

  </div>
</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA LOGIN PAGE
     ========================================================== -->
<style>
  .auth-page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: linear-gradient(135deg, #f7f7f9 0%, #ececf0 100%);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    padding: 36px 32px;
  }

  /* ---------- Kichwa ---------- */
  .auth-head {
    text-align: center;
    margin-bottom: 26px;
  }
  .auth-icon {
    font-size: 40px;
    margin-bottom: 10px;
  }
  .auth-head h1 {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin-bottom: 6px;
  }
  .auth-head p {
    color: #777;
    font-size: 14px;
  }

  /* ---------- Form ---------- */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .field input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: #fafafc;
    transition: border-color 0.15s, background 0.15s;
  }
  .field input:focus {
    border-color: #111;
    background: #fff;
  }

  /* Password toggle */
  .pw-wrap {
    position: relative;
  }
  .pw-wrap input { padding-right: 46px; }
  .pw-toggle {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    font-size: 16px;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    color: #888;
    transition: background 0.15s;
  }
  .pw-toggle:hover { background: #f2f2f5; }

  /* ---------- Remember + forgot ---------- */
  .form-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #555;
    cursor: pointer;
  }
  .check input { width: 15px; height: 15px; cursor: pointer; }
  .link-small {
    color: #e63946;
    font-weight: 600;
  }
  .link-small:hover { text-decoration: underline; }

  /* ---------- Buttons ---------- */
  .btn-lg {
    padding: 13px 20px;
    font-size: 15px;
    border-radius: 8px;
    margin-top: 4px;
  }

  /* ---------- Divider ---------- */
  .divider {
    position: relative;
    text-align: center;
    margin: 22px 0 16px;
  }
  .divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: #eee;
  }
  .divider span {
    position: relative;
    background: #fff;
    padding: 0 12px;
    color: #999;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---------- Google button ---------- */
  .btn-google {
    width: 100%;
    padding: 12px 16px;
    background: #fff;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-google:hover {
    background: #fafafc;
    border-color: #999;
  }
  .btn-google:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ---------- Footer ---------- */
  .auth-footer {
    text-align: center;
    margin-top: 22px;
    font-size: 14px;
    color: #666;
  }
  .auth-footer a {
    color: #e63946;
    font-weight: 700;
  }
  .auth-footer a:hover { text-decoration: underline; }

  /* ---------- Responsive ---------- */
  @media (max-width: 480px) {
    .auth-card {
      padding: 28px 22px;
    }
    .auth-head h1 { font-size: 21px; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA LOGIN — Firebase Auth + Firestore
     ========================================================== -->
<script type="module">

  const REDIRECT = "<%= redirect || '/' %>";

  const form  = document.getElementById('loginForm');
  const btn   = document.getElementById('loginBtn');
  const msg   = document.getElementById('loginMsg');
  const emailEl = document.getElementById('email');
  const pwEl    = document.getElementById('password');

  function showMsg(text, type = 'error') {
    msg.textContent = text;
    msg.className = 'alert ' + (type === 'error' ? 'alert-error' : 'alert-success');
    msg.style.display = 'block';
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function hideMsg() {
    msg.style.display = 'none';
  }
  function setLoading(loading) {
    btn.disabled = loading;
    btn.textContent = loading ? 'Inaingia...' : 'Ingia';
  }

  // Password toggle
  document.getElementById('pwToggle').addEventListener('click', () => {
    const isPw = pwEl.type === 'password';
    pwEl.type = isPw ? 'text' : 'password';
    document.getElementById('pwToggle').textContent = isPw ? '🙈' : '👁️';
  });

  // Sawazisha session na server
  async function syncServerSession(user) {
    try {
      await fetch('/auth/sync-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          uid: user.uid,
          email: user.email || '',
          displayName: user.displayName || '',
          photoURL: user.photoURL || ''
        })
      });
    } catch (err) {
      console.warn('syncServerSession:', err);
    }
  }

  // Submit — Login kwa Firebase Auth
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMsg();

    const email = emailEl.value.trim().toLowerCase();
    const password = pwEl.value;

    if (!email || !password) {
      showMsg('Tafadhali jaza email na password.');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg('Email si sahihi.');
      return;
    }

    setLoading(true);

    try {
      const { signInWithEmailAndPassword } = window.authFns;

      const cred = await signInWithEmailAndPassword(window.auth, email, password);
      const user = cred.user;

      await syncServerSession(user);

      showMsg('✅ Umeingia kikamilifu. Tunakupeleka...', 'success');

      setTimeout(() => {
        window.location.href = REDIRECT || '/';
      }, 600);

    } catch (err) {
      console.error('Login error:', err);
      setLoading(false);
      const code = err.code || '';
      if (code === 'auth/user-not-found' || code === 'auth/wrong-password' || code === 'auth/invalid-credential') {
        showMsg('Email au password si sahihi.');
      } else if (code === 'auth/too-many-requests') {
        showMsg('Umejaribu mara nyingi. Subiri dakika chache.');
      } else if (code === 'auth/network-request-failed') {
        showMsg('Tatizo la mtandao. Angalia internet yako.');
      } else {
        showMsg('Imeshindikana kuingia. Jaribu tena.');
      }
    }
  });

  // Google Sign-in
  document.getElementById('googleBtn').addEventListener('click', async () => {
    hideMsg();
    const btnG = document.getElementById('googleBtn');
    btnG.disabled = true;

    try {
      const { GoogleAuthProvider, signInWithPopup } = await import(
        'https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js'
      );
      const provider = new GoogleAuthProvider();
      const cred = await signInWithPopup(window.auth, provider);
      const user = cred.user;

      // Hakikisha mtumiaji yupo kwenye Firestore hata kama ni mara ya kwanza kwa Google
      try {
        const { doc, setDoc, getDoc, serverTimestamp } = window.fs;
        const ref = doc(window.db, 'users', user.uid);
        const snap = await getDoc(ref);
        if (!snap.exists()) {
          await setDoc(ref, {
            uid: user.uid,
            email: user.email || '',
            displayName: user.displayName || '',
            phone: '',
            photoURL: user.photoURL || '',
            role: 'customer',
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
          });
        }
      } catch (_) {}

      await syncServerSession(user);
      showMsg('✅ Umeingia kwa Google. Tunakupeleka...', 'success');
      setTimeout(() => {
        window.location.href = REDIRECT || '/';
      }, 600);

    } catch (err) {
      console.error('Google login error:', err);
      btnG.disabled = false;
      if (err.code !== 'auth/popup-closed-by-user') {
        showMsg('Imeshindikana kuingia kwa Google.');
      }
    }
  });

  function boot() {
    window.authFns.onAuthStateChanged(window.auth, (user) => {
      if (user) {
        if (!btn.disabled) {
          window.location.href = REDIRECT || '/';
        }
      }
    });
  }

  if (window.auth && window.authFns) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>

