<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     FORGOT PASSWORD PAGE — Firebase Auth sendPasswordResetEmail
     ========================================================== -->

<main class="auth-page">
  <div class="auth-card">

    <!-- ============ Kichwa ============ -->
    <div class="auth-head">
      <div class="auth-icon">🔒</div>
      <h1>Umesahau Password?</h1>
      <p>Weka email yako na tutakutumia link ya kubadilisha password.</p>
    </div>

    <!-- ============ Form ============ -->
    <form id="forgotForm" class="auth-form" novalidate>

      <div class="field">
        <label for="email">Email Yako *</label>
        <input
          type="email"
          id="email"
          placeholder="barua@mfano.com"
          autocomplete="email"
          required
        />
      </div>

      <!-- Message -->
      <p id="forgotMsg" class="alert" style="display:none;"></p>

      <!-- Submit -->
      <button type="submit" class="btn btn-primary btn-full btn-lg" id="sendBtn">
        Tuma Link ya Kubadilisha
      </button>

    </form>

    <!-- ============ Success (inaonekana baada ya kutuma) ============ -->
    <div id="successBox" class="success-box" style="display:none;">
      <div class="success-icon">✅</div>
      <h3>Angalia Email Yako</h3>
      <p>
        Tumekutumia link ya kubadilisha password kwenye
        <strong id="sentEmail">—</strong>.
      </p>
      <p class="success-hint">
        Kama huoni email, angalia <em>Spam</em> au <em>Junk</em> folder yako.
        Link inaisha muda baada ya dakika 60.
      </p>
      <button class="btn btn-outline btn-full" id="resendBtn" style="margin-top:14px;">
        🔄 Tuma Tena
      </button>
    </div>

    <!-- ============ Footer ============ -->
    <p class="auth-footer">
      Unakumbuka password yako?
      <a href="/auth/login">Ingia</a>
    </p>

  </div>
</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA FORGOT PASSWORD
     ========================================================== -->
<style>
  .auth-page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: linear-gradient(135deg, #f7f7f9 0%, #ececf0 100%);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    padding: 36px 32px;
  }

  /* ---------- Kichwa ---------- */
  .auth-head {
    text-align: center;
    margin-bottom: 26px;
  }
  .auth-icon {
    font-size: 40px;
    margin-bottom: 10px;
  }
  .auth-head h1 {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin-bottom: 8px;
  }
  .auth-head p {
    color: #777;
    font-size: 14px;
    line-height: 1.5;
  }

  /* ---------- Form ---------- */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .field input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: #fafafc;
    transition: border-color 0.15s, background 0.15s;
  }
  .field input:focus {
    border-color: #111;
    background: #fff;
  }

  /* ---------- Buttons ---------- */
  .btn-lg {
    padding: 13px 20px;
    font-size: 15px;
    border-radius: 8px;
    margin-top: 4px;
  }

  /* ---------- Success box ---------- */
  .success-box {
    text-align: center;
    padding: 24px 4px 8px;
    animation: fadeIn 0.35s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .success-icon {
    font-size: 46px;
    margin-bottom: 12px;
  }
  .success-box h3 {
    font-size: 18px;
    font-weight: 800;
    color: #111;
    margin-bottom: 10px;
  }
  .success-box p {
    color: #555;
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .success-box strong {
    color: #111;
    word-break: break-all;
  }
  .success-hint {
    color: #888 !important;
    font-size: 12px !important;
    background: #f7f7f9;
    padding: 10px 12px;
    border-radius: 8px;
    margin-top: 12px !important;
  }

  /* ---------- Footer ---------- */
  .auth-footer {
    text-align: center;
    margin-top: 22px;
    font-size: 14px;
    color: #666;
  }
  .auth-footer a {
    color: #e63946;
    font-weight: 700;
  }
  .auth-footer a:hover { text-decoration: underline; }

  /* ---------- Responsive ---------- */
  @media (max-width: 480px) {
    .auth-card { padding: 28px 22px; }
    .auth-head h1 { font-size: 21px; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA FORGOT PASSWORD — Firebase Auth halisi
     ========================================================== -->
<script type="module">

  // Elements
  const form     = document.getElementById('forgotForm');
  const btn      = document.getElementById('sendBtn');
  const msg      = document.getElementById('forgotMsg');
  const emailEl  = document.getElementById('email');
  const successBox = document.getElementById('successBox');
  const sentEmail  = document.getElementById('sentEmail');
  const resendBtn  = document.getElementById('resendBtn');

  // ==========================================================
  // Helpers
  // ==========================================================
  function showMsg(text, type = 'error') {
    msg.textContent = text;
    msg.className = 'alert ' + (type === 'error' ? 'alert-error' : 'alert-success');
    msg.style.display = 'block';
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function hideMsg() {
    msg.style.display = 'none';
  }
  function setLoading(loading) {
    btn.disabled = loading;
    btn.textContent = loading ? 'Inatuma...' : 'Tuma Link ya Kubadilisha';
  }

  // ==========================================================
  // Tuma email ya kubadilisha password — halisi
  // ==========================================================
  async function sendReset(email) {
    const { sendPasswordResetEmail } = window.authFns;
    await sendPasswordResetEmail(window.auth, email);
  }

  // ==========================================================
  // Submit
  // ==========================================================
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMsg();

    const email = emailEl.value.trim().toLowerCase();

    if (!email) {
      showMsg('Tafadhali weka email yako.');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg('Email si sahihi.');
      return;
    }

    setLoading(true);

    try {
      await sendReset(email);

      // Onyesha success box
      sentEmail.textContent = email;
      successBox.style.display = 'block';
      form.style.display = 'none';
      msg.style.display = 'none';

    } catch (err) {
      console.error('Forgot password error:', err);
      const code = err.code || '';

      // Kwa usalama, hatuonyeshi kama email haipo (Firebase inafanya hivi pia).
      // Hata kama email haipo, tunasema "imetumwa".
      if (code === 'auth/user-not-found' || code === 'auth/invalid-email') {
        // Kwa usalama, tunaonyesha ujumbe sawa
        sentEmail.textContent = email;
        successBox.style.display = 'block';
        form.style.display = 'none';
      } else if (code === 'auth/too-many-requests') {
        showMsg('Umejaribu mara nyingi. Subiri dakika chache kisha ujaribu tena.');
      } else if (code === 'auth/network-request-failed') {
        showMsg('Tatizo la mtandao. Angalia internet yako.');
      } else {
        showMsg('Imeshindikana kutuma. Jaribu tena baadaye.');
      }
    } finally {
      setLoading(false);
    }
  });

  // ==========================================================
  // Tuma tena (Resend)
  // ==========================================================
  resendBtn.addEventListener('click', async () => {
    const email = sentEmail.textContent;
    if (!email) return;

    resendBtn.disabled = true;
    resendBtn.textContent = 'Inatuma...';

    try {
      await sendReset(email);
      resendBtn.textContent = '✅ Imetumwa Tena';
      setTimeout(() => {
        resendBtn.disabled = false;
        resendBtn.textContent = '🔄 Tuma Tena';
      }, 2500);
    } catch (err) {
      console.error('Resend error:', err);
      const code = err.code || '';
      if (code === 'auth/too-many-requests') {
        resendBtn.textContent = '⏱️ Subiri kidogo';
      } else {
        resendBtn.textContent = '❌ Imeshindikana';
      }
      setTimeout(() => {
        resendBtn.disabled = false;
        resendBtn.textContent = '🔄 Tuma Tena';
      }, 2500);
    }
  });

  // ==========================================================
  // Boot
  // ==========================================================
  function boot() {
    // Hakuna action ya awali — form iko tayari
    // Tunaweza kuweka focus kwenye email input
    emailEl.focus();
  }

  if (window.auth && window.authFns) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
