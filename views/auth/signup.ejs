<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     SIGNUP PAGE — Firebase Auth + Firestore (users/{uid})
     ========================================================== -->

<main class="auth-page">
  <div class="auth-card">

    <!-- ============ Kichwa ============ -->
    <div class="auth-head">
      <div class="auth-icon">✨</div>
      <h1>Fungua Akaunti</h1>
      <p>Jiunge nasi upate huduma bora zaidi</p>
    </div>

    <!-- ============ Form ============ -->
    <form id="signupForm" class="auth-form" novalidate>

      <!-- Jina kamili -->
      <div class="field">
        <label for="fullName">Jina Kamili *</label>
        <input
          type="text"
          id="fullName"
          placeholder="Mfano: Asha Juma"
          autocomplete="name"
          required
        />
      </div>

      <!-- Email -->
      <div class="field">
        <label for="email">Email *</label>
        <input
          type="email"
          id="email"
          placeholder="barua@mfano.com"
          autocomplete="email"
          required
        />
      </div>

      <!-- Namba ya Simu -->
      <div class="field">
        <label for="phone">Namba ya Simu *</label>
        <input
          type="tel"
          id="phone"
          placeholder="+255 7XX XXX XXX"
          autocomplete="tel"
          required
        />
        <small class="field-hint">
          Tutatumia namba hii kukufikia kuhusu oda yako.
        </small>
      </div>

      <!-- Password -->
      <div class="field">
        <label for="password">Password *</label>
        <div class="pw-wrap">
          <input
            type="password"
            id="password"
            placeholder="Herufi 6 au zaidi"
            autocomplete="new-password"
            required
          />
          <button type="button" class="pw-toggle" data-target="password" aria-label="Onyesha password">
            👁️
          </button>
        </div>
        <!-- Strength bar -->
        <div class="pw-strength" id="pwStrength">
          <div class="bar"><span id="pwBar"></span></div>
          <small id="pwStrengthText">Weka password yenye herufi 6+</small>
        </div>
      </div>

      <!-- Retype Password -->
      <div class="field">
        <label for="password2">Rudia Password *</label>
        <div class="pw-wrap">
          <input
            type="password"
            id="password2"
            placeholder="Rudia password yako"
            autocomplete="new-password"
            required
          />
          <button type="button" class="pw-toggle" data-target="password2" aria-label="Onyesha password">
            👁️
          </button>
        </div>
      </div>

      <!-- Terms -->
      <label class="check">
        <input type="checkbox" id="agree" required />
        <span>
          Nakubaliana na
          <a href="/terms" target="_blank" class="link-small">Masharti</a> na
          <a href="/privacy" target="_blank" class="link-small">Faragha</a>
        </span>
      </label>

      <!-- Message -->
      <p id="signupMsg" class="alert" style="display:none;"></p>

      <!-- Submit -->
      <button type="submit" class="btn btn-primary btn-full btn-lg" id="signupBtn">
        Fungua Akaunti
      </button>

    </form>

    <!-- ============ Divider ============ -->
    <div class="divider"><span>au</span></div>

    <!-- ============ Google Signup ============ -->
    <button class="btn-google" id="googleBtn" type="button">
      <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
      </svg>
      Jiunge kwa Google
    </button>

    <!-- ============ Footer ============ -->
    <p class="auth-footer">
      Una akaunti tayari?
      <a href="/auth/login<%= redirect && redirect !== '/' ? '?redirect=' + encodeURIComponent(redirect) : '' %>">
        Ingia
      </a>
    </p>

  </div>
</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA SIGNUP PAGE
     ========================================================== -->
<style>
  .auth-page {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: linear-gradient(135deg, #f7f7f9 0%, #ececf0 100%);
  }

  .auth-card {
    width: 100%;
    max-width: 460px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.08);
    padding: 36px 32px;
  }

  /* ---------- Kichwa ---------- */
  .auth-head {
    text-align: center;
    margin-bottom: 26px;
  }
  .auth-icon {
    font-size: 40px;
    margin-bottom: 10px;
  }
  .auth-head h1 {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin-bottom: 6px;
  }
  .auth-head p {
    color: #777;
    font-size: 14px;
  }

  /* ---------- Form ---------- */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .field input[type="text"],
  .field input[type="email"],
  .field input[type="tel"],
  .field input[type="password"] {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: #fafafc;
    transition: border-color 0.15s, background 0.15s;
  }
  .field input:focus {
    border-color: #111;
    background: #fff;
  }
  .field-hint {
    display: block;
    color: #888;
    font-size: 12px;
    margin-top: 5px;
  }

  /* Password toggle */
  .pw-wrap {
    position: relative;
  }
  .pw-wrap input { padding-right: 46px; }
  .pw-toggle {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    font-size: 16px;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    color: #888;
    transition: background 0.15s;
  }
  .pw-toggle:hover { background: #f2f2f5; }

  /* Password strength */
  .pw-strength {
    margin-top: 8px;
  }
  .pw-strength .bar {
    height: 4px;
    background: #eee;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 5px;
  }
  .pw-strength .bar span {
    display: block;
    height: 100%;
    width: 0%;
    background: #e63946;
    border-radius: 2px;
    transition: width 0.25s, background 0.25s;
  }
  .pw-strength small {
    font-size: 12px;
    color: #888;
  }

  /* ---------- Checkbox ---------- */
  .check {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 13px;
    color: #555;
    cursor: pointer;
    line-height: 1.4;
  }
  .check input {
    width: 15px;
    height: 15px;
    margin-top: 2px;
    cursor: pointer;
    flex-shrink: 0;
  }
  .link-small {
    color: #e63946;
    font-weight: 600;
  }
  .link-small:hover { text-decoration: underline; }

  /* ---------- Buttons ---------- */
  .btn-lg {
    padding: 13px 20px;
    font-size: 15px;
    border-radius: 8px;
    margin-top: 4px;
  }

  /* ---------- Divider ---------- */
  .divider {
    position: relative;
    text-align: center;
    margin: 22px 0 16px;
  }
  .divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: #eee;
  }
  .divider span {
    position: relative;
    background: #fff;
    padding: 0 12px;
    color: #999;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---------- Google button ---------- */
  .btn-google {
    width: 100%;
    padding: 12px 16px;
    background: #fff;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: background 0.15s, border-color 0.15s;
  }
  .btn-google:hover {
    background: #fafafc;
    border-color: #999;
  }
  .btn-google:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* ---------- Footer ---------- */
  .auth-footer {
    text-align: center;
    margin-top: 22px;
    font-size: 14px;
    color: #666;
  }
  .auth-footer a {
    color: #e63946;
    font-weight: 700;
  }
  .auth-footer a:hover { text-decoration: underline; }

  /* ---------- Responsive ---------- */
  @media (max-width: 480px) {
    .auth-card {
      padding: 28px 22px;
    }
    .auth-head h1 { font-size: 21px; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA SIGNUP — Firebase Auth + Firestore halisi
     ========================================================== -->
<script type="module">

  // Redirect target kutoka server
  const REDIRECT = "<%= redirect || '/' %>";

  // Elements
  const form  = document.getElementById('signupForm');
  const btn   = document.getElementById('signupBtn');
  const msg   = document.getElementById('signupMsg');

  const nameEl  = document.getElementById('fullName');
  const emailEl = document.getElementById('email');
  const phoneEl = document.getElementById('phone');
  const pwEl    = document.getElementById('password');
  const pw2El   = document.getElementById('password2');
  const agreeEl = document.getElementById('agree');

  // ==========================================================
  // Helpers
  // ==========================================================
  function showMsg(text, type = 'error') {
    msg.textContent = text;
    msg.className = 'alert ' + (type === 'error' ? 'alert-error' : 'alert-success');
    msg.style.display = 'block';
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function hideMsg() {
    msg.style.display = 'none';
  }
  function setLoading(loading) {
    btn.disabled = loading;
    btn.textContent = loading ? 'Inafungua akaunti...' : 'Fungua Akaunti';
  }

  // ==========================================================
  // Password show/hide
  // ==========================================================
  document.querySelectorAll('.pw-toggle').forEach((b) => {
    b.addEventListener('click', () => {
      const input = document.getElementById(b.dataset.target);
      const isPw = input.type === 'password';
      input.type = isPw ? 'text' : 'password';
      b.textContent = isPw ? '🙈' : '👁️';
    });
  });

  // ==========================================================
  // Password strength meter
  // ==========================================================
  function scorePassword(pw) {
    let score = 0;
    if (!pw) return 0;
    if (pw.length >= 6) score++;
    if (pw.length >= 10) score++;
    if (/[A-Z]/.test(pw)) score++;
    if (/[0-9]/.test(pw)) score++;
    if (/[^A-Za-z0-9]/.test(pw)) score++;
    return Math.min(score, 5);
  }

  pwEl.addEventListener('input', () => {
    const score = scorePassword(pwEl.value);
    const pct = (score / 5) * 100;
    const bar = document.getElementById('pwBar');
    const txt = document.getElementById('pwStrengthText');

    bar.style.width = pct + '%';

    const colors = ['#e63946', '#e63946', '#f5a623', '#4caf50', '#2e7d32', '#2e7d32'];
    const labels = [
      'Weka password yenye herufi 6+',
      'Dhaifu sana',
      'Dhaifu',
      'Wastani',
      'Nzuri',
      'Imara sana'
    ];
    bar.style.background = colors[score];
    txt.textContent = labels[score];
    txt.style.color = colors[score];
  });

  // ==========================================================
  // Phone validation (Tanzania)
  // ==========================================================
  function normalizePhone(raw) {
    if (!raw) return '';
    let p = raw.replace(/[\s\-()]/g, '');
    if (p.startsWith('+')) p = p.slice(1);
    if (p.startsWith('0')) p = '255' + p.slice(1);
    return p;
  }
  function isValidTzPhone(raw) {
    const p = normalizePhone(raw);
    return /^255\d{9}$/.test(p);
  }

  // ==========================================================
  // Hifadhi Firestore users/{uid}
  // ==========================================================
  async function saveUserProfile(user, fullName, phoneRaw) {
    const { doc, setDoc, getDoc, serverTimestamp } = window.fs;
    const phone = normalizePhone(phoneRaw);
    const ref = doc(window.db, 'users', user.uid);
    const snap = await getDoc(ref);

    if (snap.exists()) {
      await setDoc(ref, {
        displayName: fullName,
        phone,
        email: user.email || '',
        updatedAt: serverTimestamp()
      }, { merge: true });
    } else {
      await setDoc(ref, {
        uid: user.uid,
        email: user.email || '',
        displayName: fullName,
        phone,
        photoURL: user.photoURL || '',
        role: 'customer',
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp()
      });
    }
  }

  // ==========================================================
  // Sync server session
  // ==========================================================
  async function syncServerSession(user) {
    try {
      await fetch('/auth/sync-session', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          uid: user.uid,
          email: user.email || '',
          displayName: user.displayName || '',
          photoURL: user.photoURL || ''
        })
      });
    } catch (err) {
      console.warn('syncServerSession:', err);
    }
  }

  // ==========================================================
  // Submit — Signup halisi
  // ==========================================================
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideMsg();

    const fullName = nameEl.value.trim();
    const email    = emailEl.value.trim().toLowerCase();
    const phoneRaw = phoneEl.value.trim();
    const password = pwEl.value;
    const password2 = pw2El.value;

    if (!fullName || fullName.length < 3) {
      showMsg('Tafadhali weka jina lako kamili (herufi 3+).');
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showMsg('Email si sahihi.');
      return;
    }
    if (!phoneRaw || !isValidTzPhone(phoneRaw)) {
      showMsg('Namba ya simu si sahihi. Tumia mfano: 0712345678 au +255712345678.');
      return;
    }
    if (!password || password.length < 6) {
      showMsg('Password iwe na herufi 6 au zaidi.');
      return;
    }
    if (password !== password2) {
      showMsg('Password hazifanani.');
      return;
    }
    if (!agreeEl.checked) {
      showMsg('Tafadhali kubali Masharti na Sera ya Faragha.');
      return;
    }

    setLoading(true);

    try {
      const { createUserWithEmailAndPassword, updateProfile } = window.authFns;

      const cred = await createUserWithEmailAndPassword(window.auth, email, password);
      const user = cred.user;

      try {
        await updateProfile(user, { displayName: fullName });
      } catch (err) {
        console.warn('updateProfile:', err);
      }

      await saveUserProfile(user, fullName, phoneRaw);
      await syncServerSession(user);

      showMsg('✅ Akaunti yako imefunguliwa! Tunakupeleka...', 'success');

      setTimeout(() => {
        window.location.href = REDIRECT || '/';
      }, 700);

    } catch (err) {
      console.error('Signup error:', err);
      setLoading(false);
      const code = err.code || '';
      if (code === 'auth/email-already-in-use') {
        showMsg('Email hii tayari inatumika. Jaribu kuingia au tumia email nyingine.');
      } else if (code === 'auth/invalid-email') {
        showMsg('Email si sahihi.');
      } else if (code === 'auth/weak-password') {
        showMsg('Password ni dhaifu. Tumia herufi 6+ pamoja na namba.');
      } else if (code === 'auth/network-request-failed') {
        showMsg('Tatizo la mtandao. Angalia internet yako.');
      } else {
        showMsg('Imeshindikana kufungua akaunti. Jaribu tena.');
      }
    }
  });

  // ==========================================================
  // Google Signup (hiari)
  // ==========================================================
  document.getElementById('googleBtn').addEventListener('click', async () => {
    hideMsg();
    const btnG = document.getElementById('googleBtn');
    btnG.disabled = true;

    try {
      const { GoogleAuthProvider, signInWithPopup } = await import(
        'https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js'
      );
      const provider = new GoogleAuthProvider();
      const cred = await signInWithPopup(window.auth, provider);
      const user = cred.user;

      const phoneRaw = phoneEl.value.trim();
      const validPhone = phoneRaw && isValidTzPhone(phoneRaw);

      try {
        const { doc, setDoc, getDoc, serverTimestamp } = window.fs;
        const ref = doc(window.db, 'users', user.uid);
        const snap = await getDoc(ref);
        if (!snap.exists()) {
          await setDoc(ref, {
            uid: user.uid,
            email: user.email || '',
            displayName: user.displayName || '',
            phone: validPhone ? normalizePhone(phoneRaw) : '',
            photoURL: user.photoURL || '',
            role: 'customer',
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
          });
        } else if (validPhone) {
          await setDoc(ref, {
            phone: normalizePhone(phoneRaw),
            updatedAt: serverTimestamp()
          }, { merge: true });
        }
      } catch (err) {
        console.warn('Google save:', err);
      }

      await syncServerSession(user);
      showMsg('✅ Umejiunga kwa Google! Tunakupeleka...', 'success');
      setTimeout(() => {
        window.location.href = REDIRECT || '/';
      }, 700);

    } catch (err) {
      console.error('Google signup error:', err);
      btnG.disabled = false;
      if (err.code !== 'auth/popup-closed-by-user') {
        showMsg('Imeshindikana kujiunga kwa Google.');
      }
    }
  });

  // ==========================================================
  // Boot function imesafishwa kuzuia kuruka hovyo kwenye Signup
  // ==========================================================
  function boot() {
    // Haifanyi redirect ya ghafla tena, hivyo inakuacha utulie kwenye ukurasa wa kujisajili
  }

  if (window.auth && window.authFns) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>

