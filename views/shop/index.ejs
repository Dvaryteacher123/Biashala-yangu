<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     HOME PAGE
     ========================================================== -->

<main class="home">

  <!-- ============ HERO BANNER (Firestore: banners) ============ -->
  <section class="hero" id="heroSection">
    <div class="container">
      <div class="hero-card" id="heroCard">
        <div class="hero-text">
          <span class="hero-badge">🔥 Ofa Mpya</span>
          <h1 id="heroTitle">Karibu ClothingStore</h1>
          <p id="heroSubtitle">Nguo bora kwa bei nafuu — karibu uone mwenyewe.</p>
          <a href="/shop" class="btn btn-primary" id="heroBtn">Nunua Sasa</a>
        </div>
        <div class="hero-image" id="heroImageWrap">
          <!-- Picha inaingizwa na JS kutoka Firestore -->
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CATEGORIES (Firestore: categories) ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Makundi</h2>
        <a href="/shop" class="see-all">Ona Zote →</a>
      </div>

      <div id="categoriesLoading" class="loading">
        <div class="spinner"></div> Inapakia makundi...
      </div>
      <div class="category-grid" id="categoryGrid" style="display:none;"></div>
      <div class="empty-state" id="categoriesEmpty" style="display:none;">
        <h3>Hakuna makundi bado</h3>
        <p>Makundi yataonekana hapa yakiongezwa.</p>
      </div>
    </div>
  </section>

  <!-- ============ FEATURED PRODUCTS (Firestore: products) ============ -->
  <section class="section alt-bg">
    <div class="container">
      <div class="section-head">
        <h2>Bidhaa Zilizochaguliwa</h2>
        <a href="/shop?sort=featured" class="see-all">Ona Zote →</a>
      </div>

      <div id="featuredLoading" class="loading">
        <div class="spinner"></div> Inapakia bidhaa...
      </div>
      <div class="product-grid" id="featuredGrid" style="display:none;"></div>
      <div class="empty-state" id="featuredEmpty" style="display:none;">
        <h3>Hakuna bidhaa zilizochaguliwa</h3>
        <p>Bidhaa zitaonekana hapa zikiwekwa "featured".</p>
      </div>
    </div>
  </section>

  <!-- ============ NEW ARRIVALS (Firestore: products) ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Bidhaa Mpya</h2>
        <a href="/shop?sort=newest" class="see-all">Ona Zote →</a>
      </div>

      <div id="newLoading" class="loading">
        <div class="spinner"></div> Inapakia bidhaa...
      </div>
      <div class="product-grid" id="newGrid" style="display:none;"></div>
      <div class="empty-state" id="newEmpty" style="display:none;">
        <h3>Hakuna bidhaa mpya</h3>
        <p>Bidhaa mpya zitaonekana hapa.</p>
      </div>
    </div>
  </section>

  <!-- ============ BENEFITS ============ -->
  <section class="section benefits">
    <div class="container benefits-grid">
      <div class="benefit">
        <div class="benefit-icon">🚚</div>
        <h4>Usafirishaji wa Haraka</h4>
        <p>Tunafikisha bidhaa popote Tanzania kwa siku 1–3.</p>
      </div>
      <div class="benefit">
        <div class="benefit-icon">💯</div>
        <h4>Bidhaa za Ubora</h4>
        <p>Bidhaa zote zimechaguliwa kwa ubora wa hali ya juu.</p>
      </div>
      <div class="benefit">
        <div class="benefit-icon">🔒</div>
        <h4>Malipo Salama</h4>
        <p>Malipo yako yanalindwa kwa teknolojia ya kisasa.</p>
      </div>
      <div class="benefit">
        <div class="benefit-icon">↩️</div>
        <h4>Kurudisha Rahisi</h4>
        <p>Unaweza kurudisha bidhaa ndani ya siku 7.</p>
      </div>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA HOME PAGE
     ========================================================== -->
<style>
  /* ---------- Sections ---------- */
  .section {
    padding: 50px 0;
  }
  .section.alt-bg {
    background: #f0f0f3;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 10px;
  }
  .section-head h2 {
    font-size: 24px;
    font-weight: 700;
    color: #111;
  }
  .see-all {
    color: #e63946;
    font-weight: 600;
    font-size: 14px;
  }
  .see-all:hover { text-decoration: underline; }

  /* ============ HERO ============ */
  .hero {
    padding: 40px 0 20px;
  }
  .hero-card {
    background: linear-gradient(135deg, #111 0%, #2a2a2a 100%);
    color: #fff;
    border-radius: 16px;
    padding: 50px 40px;
    display: flex;
    align-items: center;
    gap: 30px;
    min-height: 320px;
    overflow: hidden;
    position: relative;
  }
  .hero-text {
    flex: 1;
    max-width: 550px;
  }
  .hero-badge {
    display: inline-block;
    background: #e63946;
    color: #fff;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .hero-text h1 {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 14px;
  }
  .hero-text p {
    color: #ccc;
    font-size: 16px;
    margin-bottom: 24px;
  }
  .hero-text .btn-primary {
    background: #e63946;
  }
  .hero-text .btn-primary:hover {
    background: #c53030;
  }
  .hero-image {
    flex-shrink: 0;
    width: 320px;
    height: 260px;
    border-radius: 12px;
    overflow: hidden;
    background: #333;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ============ CATEGORIES ============ */
  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
  }
  .category-card {
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    text-align: center;
    padding: 22px 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    transition: transform 0.2s, box-shadow 0.2s;
    color: #111;
  }
  .category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
  }
  .category-card .cat-img {
    width: 70px;
    height: 70px;
    border-radius: 50%;
    margin: 0 auto 12px;
    background: #f2f2f5;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
  }
  .category-card .cat-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .category-card .cat-name {
    font-weight: 600;
    font-size: 15px;
  }
  .category-card .cat-count {
    color: #888;
    font-size: 12px;
    margin-top: 2px;
  }

  /* ============ BENEFITS ============ */
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .benefit {
    background: #fff;
    padding: 24px 20px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }
  .benefit-icon {
    font-size: 32px;
    margin-bottom: 10px;
  }
  .benefit h4 {
    font-size: 16px;
    margin-bottom: 6px;
    color: #111;
  }
  .benefit p {
    color: #666;
    font-size: 13px;
  }

  /* ============ Responsive ============ */
  @media (max-width: 800px) {
    .hero-card {
      flex-direction: column-reverse;
      padding: 30px 24px;
      text-align: center;
    }
    .hero-text h1 { font-size: 26px; }
    .hero-image {
      width: 100%;
      height: 200px;
    }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA HOME PAGE — Inasoma Firestore (data halisi)
     ========================================================== -->
<script type="module">

  // ==========================================================
  // Helper: tengeneza HTML ya bidhaa moja
  // ==========================================================
  function productCardHTML(p) {
    const img = p.image || (p.images && p.images[0]) || '';
    const price = Number(p.price || 0).toLocaleString();
    const oldPrice = p.oldPrice ? `<span class="old-price" style="text-decoration:line-through;color:#999;font-size:13px;margin-left:6px;">TSh ${Number(p.oldPrice).toLocaleString()}</span>` : '';
    return `
      <a href="/product/${p.id}" class="product-card">
        <img src="${img || 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22240%22><rect fill=%22%23eee%22 width=%22200%22 height=%22240%22/><text x=%22100%22 y=%22125%22 font-size=%2216%22 fill=%22%23999%22 text-anchor=%22middle%22>Hakuna picha</text></svg>'}"
             alt="${p.name || 'Bidhaa'}" loading="lazy" />
        <div class="info">
          <div class="name">${p.name || 'Bidhaa'}</div>
          <div class="price">TSh ${price} ${oldPrice}</div>
        </div>
      </a>
    `;
  }

  // ==========================================================
  // 1. HERO — Firestore: banners (active == true, limit 1)
  //    Kama hakuna banner, inaacha default ya HTML (hakuna data ya uongo)
  // ==========================================================
  async function loadHero() {
    try {
      const { collection, query, where, limit, getDocs } = window.fs;
      const q = query(
        collection(window.db, 'banners'),
        where('active', '==', true),
        limit(1)
      );
      const snap = await getDocs(q);
      if (snap.empty) return; // acha default

      const b = snap.docs[0].data();
      if (b.title)    document.getElementById('heroTitle').textContent    = b.title;
      if (b.subtitle) document.getElementById('heroSubtitle').textContent = b.subtitle;
      const btn = document.getElementById('heroBtn');
      if (b.link)  btn.href = b.link;
      if (b.cta)   btn.textContent = b.cta;
      if (b.image) {
        document.getElementById('heroImageWrap').innerHTML =
          `<img src="${b.image}" alt="Bango" />`;
      }
    } catch (err) {
      console.error('Hero error:', err);
    }
  }

  // ==========================================================
  // 2. CATEGORIES — Firestore: categories
  // ==========================================================
  async function loadCategories() {
    const loading = document.getElementById('categoriesLoading');
    const grid    = document.getElementById('categoryGrid');
    const empty   = document.getElementById('categoriesEmpty');

    try {
      const { collection, getDocs, query, orderBy } = window.fs;
      let snap;
      try {
        snap = await getDocs(query(collection(window.db, 'categories'), orderBy('name')));
      } catch {
        // fallback kama orderBy inahitaji index
        snap = await getDocs(collection(window.db, 'categories'));
      }

      loading.style.display = 'none';

      if (snap.empty) {
        empty.style.display = 'block';
        return;
      }

      let html = '';
      snap.forEach((d) => {
        const c = d.data();
        const img = c.image
          ? `<img src="${c.image}" alt="${c.name || ''}" />`
          : '🛍️';
        html += `
          <a href="/shop?category=${d.id}" class="category-card">
            <div class="cat-img">${img}</div>
            <div class="cat-name">${c.name || 'Bila jina'}</div>
            <div class="cat-count">${c.productCount || 0} bidhaa</div>
          </a>
        `;
      });
      grid.innerHTML = html;
      grid.style.display = 'grid';
    } catch (err) {
      console.error('Categories error:', err);
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  // ==========================================================
  // 3. FEATURED PRODUCTS — Firestore: products (featured == true)
  // ==========================================================
  async function loadFeatured() {
    const loading = document.getElementById('featuredLoading');
    const grid    = document.getElementById('featuredGrid');
    const empty   = document.getElementById('featuredEmpty');

    try {
      const { collection, query, where, limit, getDocs } = window.fs;
      const q = query(
        collection(window.db, 'products'),
        where('featured', '==', true),
        limit(8)
      );
      const snap = await getDocs(q);
      loading.style.display = 'none';

      if (snap.empty) {
        empty.style.display = 'block';
        return;
      }
      grid.innerHTML = snap.docs.map((d) =>
        productCardHTML({ id: d.id, ...d.data() })
      ).join('');
      grid.style.display = 'grid';
    } catch (err) {
      console.error('Featured error:', err);
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  // ==========================================================
  // 4. NEW ARRIVALS — Firestore: products (orderBy createdAt desc)
  // ==========================================================
  async function loadNewArrivals() {
    const loading = document.getElementById('newLoading');
    const grid    = document.getElementById('newGrid');
    const empty   = document.getElementById('newEmpty');

    try {
      const { collection, query, orderBy, limit, getDocs } = window.fs;
      let snap;
      try {
        snap = await getDocs(query(
          collection(window.db, 'products'),
          orderBy('createdAt', 'desc'),
          limit(8)
        ));
      } catch {
        // fallback kama createdAt haipo
        snap = await getDocs(query(collection(window.db, 'products'), limit(8)));
      }

      loading.style.display = 'none';

      if (snap.empty) {
        empty.style.display = 'block';
        return;
      }
      grid.innerHTML = snap.docs.map((d) =>
        productCardHTML({ id: d.id, ...d.data() })
      ).join('');
      grid.style.display = 'grid';
    } catch (err) {
      console.error('New arrivals error:', err);
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  // ==========================================================
  // Anzisha
  // ==========================================================
  function boot() {
    loadHero();
    loadCategories();
    loadFeatured();
    loadNewArrivals();
  }

  if (window.fs && window.db) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
