    font-size: 12px;
    margin-top: 10px;
  }
  .danger-hint a { color: #e63946; font-weight: 600; }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .profile-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA PROFILE — Firestore + Firebase Auth halisi
     ========================================================== -->
<script type="module">

  // State
  const state = {
    user: null,
    profile: null
  };

  // ==========================================================
  // Helpers
  // ==========================================================
  function setAvatar(el, name, photoURL) {
    if (photoURL) {
      el.textContent = '';
      el.style.backgroundImage = `url("${photoURL}")`;
    } else {
      el.style.backgroundImage = '';
      const initial = (name || '?').charAt(0).toUpperCase();
      el.textContent = initial;
    }
  }

  function showMsg(el, text, type = 'error') {
    el.textContent = text;
    el.className = 'alert ' + (type === 'error' ? 'alert-error' : 'alert-success');
    el.style.display = 'block';
  }
  function hideMsg(el) { el.style.display = 'none'; }

  function normalizePhone(raw) {
    if (!raw) return '';
    let p = raw.replace(/[\s\-()]/g, '');
    if (p.startsWith('+')) p = p.slice(1);
    if (p.startsWith('0')) p = '255' + p.slice(1);
    return p;
  }
  function isValidTzPhone(raw) {
    const p = normalizePhone(raw);
    return /^255\d{9}$/.test(p);
  }

  // ==========================================================
  // 1. Pakia wasifu kutoka Firestore users/{uid}
  //    Kama haipo, tengeneza kwa Auth data (data halisi)
  // ==========================================================
  async function loadProfile() {
    const loading = document.getElementById('profLoading');
    const login = document.getElementById('profLogin');
    const content = document.getElementById('profContent');

    loading.style.display = 'flex';
    login.style.display = 'none';
    content.style.display = 'none';

    if (!state.user) {
      loading.style.display = 'none';
      login.style.display = 'block';
      document.getElementById('profLoginLink').href =
        '/auth/login?redirect=' + encodeURIComponent('/account/profile');
      return;
    }

    try {
      const { doc, getDoc, setDoc, serverTimestamp } = window.fs;
      const ref = doc(window.db, 'users', state.user.uid);
      const snap = await getDoc(ref);

      let profile;
      if (snap.exists()) {
        profile = snap.data();
      } else {
        // Tengeneza document mpya kwa taarifa halisi kutoka Firebase Auth
        profile = {
          uid: state.user.uid,
          email: state.user.email || '',
          displayName: state.user.displayName || '',
          photoURL: state.user.photoURL || '',
          phone: '',
          role: 'customer',
          createdAt: serverTimestamp(),
          updatedAt: serverTimestamp()
        };
        await setDoc(ref, profile);
      }

      state.profile = profile;
      renderProfile(profile);
      loadStats();

      loading.style.display = 'none';
      content.style.display = 'block';

    } catch (err) {
      console.error('Load profile error:', err);
      loading.style.display = 'none';
      login.style.display = 'block';
    }
  }

  // ==========================================================
  // 2. Render
  // ==========================================================
  function renderProfile(p) {
    const name = p.displayName || p.email?.split('@')[0] || '';
    const email = p.email || '';
    const photoURL = p.photoURL || '';

    // Sidebar
    setAvatar(document.getElementById('avatarBox'), name, photoURL);
    document.getElementById('asideName').textContent = name;
    document.getElementById('asideEmail').textContent = email;
    document.getElementById('asideRole').textContent = p.role || 'mteja';

    // Form
    document.getElementById('fName').value = p.displayName || '';
    document.getElementById('fEmail').value = email;
    document.getElementById('fPhone').value = p.phone || '';
    document.getElementById('fPhoto').value = p.photoURL || '';
  }

  // ==========================================================
  // 3. Stats (orders, wishlist)
  // ==========================================================
  async function loadStats() {
    if (!state.user) return;
    const { collection, getDocs, query, where } = window.fs;

    // Orders
    try {
      const snap = await getDocs(query(
        collection(window.db, 'orders'),
        where('userId', '==', state.user.uid)
      ));
      document.getElementById('statOrders').textContent = snap.size;
    } catch (_) {
      // kama index haipo, acha 0
    }

    // Wishlist
    try {
      const snap = await getDocs(collection(window.db, 'users', state.user.uid, 'wishlist'));
      document.getElementById('statWish').textContent = snap.size;
    } catch (_) {}
  }

  // ==========================================================
  // 4. Save profile
  // ==========================================================
  function bindProfileForm() {
    const form = document.getElementById('profileForm');
    const btn  = document.getElementById('saveProfileBtn');
    const msg  = document.getElementById('profileMsg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMsg(msg);

      const name  = document.getElementById('fName').value.trim();
      const phoneRaw = document.getElementById('fPhone').value.trim();
      const photo = document.getElementById('fPhoto').value.trim();

      if (!name || name.length < 3) {
        showMsg(msg, 'Jina lako liwe na herufi 3+');
        return;
      }
      if (phoneRaw && !isValidTzPhone(phoneRaw)) {
        showMsg(msg, 'Namba ya simu si sahihi. Tumia mfano: 0712345678.');
        return;
      }
      if (photo && !/^https?:\/\//i.test(photo)) {
        showMsg(msg, 'Photo URL lazima ianze na https://');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Inahifadhi...';

      try {
        const phone = phoneRaw ? normalizePhone(phoneRaw) : '';
        const { doc, setDoc, serverTimestamp } = window.fs;

        // 1. Firestore update (halisi)
        await setDoc(doc(window.db, 'users', state.user.uid), {
          displayName: name,
          phone,
          photoURL: photo,
          updatedAt: serverTimestamp()
        }, { merge: true });

        // 2. Firebase Auth profile update
        try {
          const { updateProfile } = window.authFns;
          await updateProfile(state.user, {
            displayName: name,
            photoURL: photo || null
          });
        } catch (err) {
          console.warn('updateProfile:', err);
        }

        // 3. Update UI
        state.profile = { ...state.profile, displayName: name, phone, photoURL: photo };
        renderProfile(state.profile);

        showMsg(msg, '✅ Taarifa zimehifadhiwa!', 'success');
        setTimeout(() => hideMsg(msg), 3000);

      } catch (err) {
        console.error('Save profile error:', err);
        showMsg(msg, 'Imeshindikana kuhifadhi. Jaribu tena.');
      } finally {
        btn.disabled = false;
        btn.textContent = '💾 Hifadhi Mabadiliko';
      }
    });
  }

  // ==========================================================
  // 5. Password change (Firebase Auth)
  // ==========================================================
  function bindPwForm() {
    const form = document.getElementById('pwForm');
    const btn  = document.getElementById('savePwBtn');
    const msg  = document.getElementById('pwMsg');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMsg(msg);

      const current = document.getElementById('pwCurrent').value;
      const next    = document.getElementById('pwNew').value;
      const confirm = document.getElementById('pwConfirm').value;

      if (!current || !next || !confirm) {
        showMsg(msg, 'Tafadhali jaza sehemu zote.');
        return;
      }
      if (next.length < 6) {
        showMsg(msg, 'Password mpya iwe herufi 6+.');
        return;
      }
      if (next !== confirm) {
        showMsg(msg, 'Password hazifanani.');
        return;
      }
      if (next === current) {
        showMsg(msg, 'Password mpya isifanane na ya sasa.');
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Inabadilisha...';

      try {
        // Re-authenticate kwanza (usalama wa Firebase)
        const { EmailAuthProvider, reauthenticateWithCredential, updatePassword } = await import(
          'https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js'
        );

        const cred = EmailAuthProvider.credential(state.user.email, current);
        await reauthenticateWithCredential(state.user, cred);

        // Sasa badilisha
        await updatePassword(state.user, next);

        showMsg(msg, '✅ Password imebadilishwa!', 'success');
        form.reset();
        setTimeout(() => hideMsg(msg), 3000);

      } catch (err) {
        console.error('Password change error:', err);
        const code = err.code || '';
        if (code === 'auth/wrong-password' || code === 'auth/invalid-credential') {
          showMsg(msg, 'Password ya sasa si sahihi.');
        } else if (code === 'auth/weak-password') {
          showMsg(msg, 'Password mpya ni dhaifu.');
        } else if (code === 'auth/requires-recent-login') {
          showMsg(msg, 'Tafadhali ingia tena kisha ujaribu.');
        } else {
          showMsg(msg, 'Imeshindikana kubadilisha password.');
        }
      } finally {
        btn.disabled = false;
        btn.textContent = '🔒 Badilisha Password';
      }
    });
  }

  // ==========================================================
  // 6. Password toggle
  // ==========================================================
  function bindPwToggles() {
    document.querySelectorAll('.pw-toggle').forEach((b) => {
      b.addEventListener('click', () => {
        const input = document.getElementById(b.dataset.target);
        const isPw = input.type === 'password';
        input.type = isPw ? 'text' : 'password';
        b.textContent = isPw ? '🙈' : '👁️';
      });
    });
  }

  // ==========================================================
  // 7. Logout
  // ==========================================================
  function bindLogout() {
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try { await fetch('/auth/logout', { method: 'POST' }); } catch (_) {}
      try { await window.authFns.signOut(window.auth); } catch (_) {}
      window.location.href = '/';
    });
  }

  // ==========================================================
  // 8. Boot
  // ==========================================================
  function initAuth() {
    window.authFns.onAuthStateChanged(window.auth, (user) => {
      state.user = user;
      loadProfile();
    });
  }

  function boot() {
    bindProfileForm();
    bindPwForm();
    bindPwToggles();
    bindLogout();
    initAuth();
  }

  if (window.auth && window.fs) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
