<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     PROFILE PAGE — Firestore users/{uid} (data halisi)
     Mtumiaji LAZIMA awe ameingia
     ========================================================== -->

<main class="profile-page">
  <div class="container">

    <!-- Loading -->
    <div id="profLoading" class="loading">
      <div class="spinner"></div> Inapakia wasifu...
    </div>

    <!-- Login required -->
    <div id="profLogin" class="empty-state" style="display:none;">
      <h3>Ingia ili kuona wasifu wako</h3>
      <p>Wasifu unahifadhiwa kwenye akaunti yako.</p>
      <a id="profLoginLink" href="/auth/login" class="btn btn-primary" style="margin-top:14px;">
        Ingia / Jiunge
      </a>
    </div>

    <!-- Content -->
    <div id="profContent" style="display:none;">

      <div class="profile-head">
        <h1>👤 Wasifu Wangu</h1>
      </div>

      <div class="profile-layout">

        <!-- ============ Sidebar ============ -->
        <aside class="profile-aside">

          <!-- Avatar card -->
          <div class="aside-card">
            <div class="avatar-wrap">
              <div class="avatar" id="avatarBox">?</div>
            </div>
            <h3 class="aside-name" id="asideName">—</h3>
            <p class="aside-email" id="asideEmail">—</p>
            <span class="role-badge" id="asideRole">mteja</span>

            <div class="aside-stats">
              <div class="stat">
                <span class="stat-num" id="statOrders">0</span>
                <span class="stat-label">Oda</span>
              </div>
              <div class="stat">
                <span class="stat-num" id="statWish">0</span>
                <span class="stat-label">Wishlist</span>
              </div>
            </div>
          </div>

          <!-- Menu ya akaunti -->
          <nav class="aside-nav">
            <a href="/account/profile" class="aside-link active">👤 Wasifu</a>
            <a href="/account/orders" class="aside-link">📦 Oda Zangu</a>
            <a href="/account/addresses" class="aside-link">📍 Anwani Zangu</a>
            <a href="/wishlist" class="aside-link">❤️ Wishlist</a>
            <button class="aside-link danger" id="logoutBtn">🚪 Toka</button>
          </nav>
        </aside>

        <!-- ============ Main ============ -->
        <section class="profile-main">

          <!-- ============ Taarifa za Msingi ============ -->
          <div class="p-card">
            <div class="p-card-head">
              <h3>Taarifa za Msingi</h3>
            </div>

            <form id="profileForm" class="p-form">

              <div class="field">
                <label for="fName">Jina Kamili</label>
                <input type="text" id="fName" placeholder="Jina lako" />
              </div>

              <div class="field">
                <label for="fEmail">Email</label>
                <input type="email" id="fEmail" disabled />
                <small class="field-hint">Email haiwezi kubadilishwa hapa.</small>
              </div>

              <div class="field">
                <label for="fPhone">Namba ya Simu</label>
                <input type="tel" id="fPhone" placeholder="+255 7XX XXX XXX" />
              </div>

              <div class="field">
                <label for="fPhoto">Photo URL (si lazima)</label>
                <input type="url" id="fPhoto" placeholder="https://..." />
                <small class="field-hint">Weka link ya picha yako (kutoka https).</small>
              </div>

              <p id="profileMsg" class="alert" style="display:none;"></p>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="saveProfileBtn">
                  💾 Hifadhi Mabadiliko
                </button>
              </div>
            </form>
          </div>

          <!-- ============ Kubadilisha Password ============ -->
          <div class="p-card">
            <div class="p-card-head">
              <h3>Kubadilisha Password</h3>
            </div>

            <form id="pwForm" class="p-form">

              <div class="field">
                <label for="pwCurrent">Password ya Sasa *</label>
                <div class="pw-wrap">
                  <input type="password" id="pwCurrent" autocomplete="current-password" required />
                  <button type="button" class="pw-toggle" data-target="pwCurrent">👁️</button>
                </div>
              </div>

              <div class="field">
                <label for="pwNew">Password Mpya *</label>
                <div class="pw-wrap">
                  <input type="password" id="pwNew" autocomplete="new-password" required />
                  <button type="button" class="pw-toggle" data-target="pwNew">👁️</button>
                </div>
              </div>

              <div class="field">
                <label for="pwConfirm">Rudia Password Mpya *</label>
                <div class="pw-wrap">
                  <input type="password" id="pwConfirm" autocomplete="new-password" required />
                  <button type="button" class="pw-toggle" data-target="pwConfirm">👁️</button>
                </div>
              </div>

              <p id="pwMsg" class="alert" style="display:none;"></p>

              <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="savePwBtn">
                  🔒 Badilisha Password
                </button>
              </div>
            </form>
          </div>

          <!-- ============ Danger zone ============ -->
          <div class="p-card danger-card">
            <div class="p-card-head">
              <h3 style="color:#c62828;">Eneo la Hatari</h3>
            </div>
            <p class="danger-text">
              Ukifuta akaunti, taarifa zako zote zitaondolewa kabisa na haziwezi kurudishwa.
            </p>
            <button class="btn btn-danger" id="deleteAccountBtn" style="display:none;">
              🗑️ Futa Akaunti
            </button>
            <p class="danger-hint">
              Ili kufuta akaunti, tafadhali wasiliana nasi kwa
              <a href="/contact">ukurasa wa mawasiliano</a>.
            </p>
          </div>

        </section>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA PROFILE PAGE
     ========================================================== -->
<style>
  .profile-page { padding: 30px 0 60px; min-height: 60vh; }

  .profile-head {
    margin-bottom: 24px;
  }
  .profile-head h1 {
    font-size: 26px;
    font-weight: 800;
    color: #111;
  }

  .profile-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 24px;
    align-items: start;
  }

  /* ============ SIDEBAR ============ */
  .profile-aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .aside-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 24px 20px;
    text-align: center;
  }

  .avatar-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 14px;
  }
  .avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, #111 0%, #333 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 34px;
    background-size: cover;
    background-position: center;
    border: 4px solid #f2f2f5;
  }

  .aside-name {
    font-size: 17px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
    word-break: break-word;
  }
  .aside-email {
    font-size: 12px;
    color: #888;
    margin-bottom: 10px;
    word-break: break-all;
  }
  .role-badge {
    display: inline-block;
    background: #111;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 16px;
  }

  .aside-stats {
    display: flex;
    border-top: 1px solid #f0f0f3;
    padding-top: 14px;
  }
  .stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat + .stat { border-left: 1px solid #f0f0f3; }
  .stat-num {
    font-size: 20px;
    font-weight: 800;
    color: #111;
  }
  .stat-label {
    font-size: 11px;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Nav */
  .aside-nav {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .aside-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 8px;
    font-size: 14px;
    color: #333;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-weight: 500;
    transition: background 0.15s;
  }
  .aside-link:hover { background: #f2f2f5; }
  .aside-link.active {
    background: #111;
    color: #fff;
    font-weight: 600;
  }
  .aside-link.danger { color: #dc3545; }
  .aside-link.danger:hover { background: #fdecea; }

  /* ============ MAIN ============ */
  .profile-main {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .p-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 24px;
  }
  .p-card-head {
    padding-bottom: 14px;
    border-bottom: 1px solid #f0f0f3;
    margin-bottom: 20px;
  }
  .p-card-head h3 {
    font-size: 17px;
    font-weight: 700;
    color: #111;
  }

  .p-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .field input {
    width: 100%;
    padding: 12px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
