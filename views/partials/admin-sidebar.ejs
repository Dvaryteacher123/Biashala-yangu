<!-- ==========================================================
     CSS YA ADMIN SIDEBAR
     ========================================================== -->
<style>
  /* ---------- Sidebar ---------- */
  .admin-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 250px;
    height: 100vh;
    background: #111;
    color: #ddd;
    display: flex;
    flex-direction: column;
    padding: 18px 0 0;
    overflow-y: auto;
    z-index: 1200;
    transition: transform 0.25s ease;
  }

  /* ---------- Logo ---------- */
  .admin-logo {
    padding: 0 20px 16px;
    border-bottom: 1px solid #222;
  }
  .admin-logo a {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
  }
  .admin-logo .logo-icon { font-size: 22px; }
  .admin-logo .logo-text strong { color: #e63946; }

  /* ---------- Admin Profile ---------- */
  .admin-profile {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid #222;
  }
  .admin-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e63946;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 16px;
    flex-shrink: 0;
  }
  .admin-info {
    overflow: hidden;
  }
  .admin-name {
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .admin-role {
    color: #888;
    font-size: 12px;
  }

  /* ---------- Menu ---------- */
  .admin-nav {
    flex: 1;
    padding: 14px 10px;
  }
  .nav-section {
    color: #666;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 14px 12px 6px;
    font-weight: 700;
  }

  .admin-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 6px;
    color: #ccc;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s, color 0.15s;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .admin-link:hover {
    background: #1c1c1c;
    color: #fff;
  }
  .admin-link.active {
    background: #e63946;
    color: #fff;
  }
  .admin-link.danger { color: #f87171; }
  .admin-link.danger:hover { background: #2a1414; color: #fca5a5; }

  /* ---------- Footer ya sidebar ---------- */
  .admin-sidebar-footer {
    padding: 10px;
    border-top: 1px solid #222;
  }

  /* ---------- Overlay (mobile) ---------- */
  .admin-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 1100;
    display: none;
  }
  .admin-overlay.open { display: block; }

  /* ---------- Hamburger ---------- */
  .admin-hamburger {
    position: fixed;
    top: 14px;
    left: 14px;
    z-index: 1150;
    display: none;
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: #111;
    color: #fff;
    font-size: 20px;
    align-items: center;
    justify-content: center;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .admin-sidebar {
      transform: translateX(-100%);
    }
    .admin-sidebar.open {
      transform: translateX(0);
    }
    .admin-hamburger {
      display: inline-flex;
    }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA ADMIN SIDEBAR
     - Ulinzi: role === "admin" kutoka Firestore users/{uid}
     - Highlight link inayotumika
     - Mobile toggle
     - Logout (Firebase Auth + server session)
     ========================================================== -->
<script type="module">

  // ---------- Highlight active link ----------
  document.querySelectorAll('.admin-link').forEach((a) => {
    if (a.getAttribute('href') && a.getAttribute('href') === location.pathname) {
      a.classList.add('active');
    }
  });

  // ---------- Mobile toggle ----------
  const sidebar   = document.getElementById('adminSidebar');
  const overlay   = document.getElementById('adminOverlay');
  const hamburger = document.getElementById('adminHamburger');

  if (hamburger) {
    hamburger.addEventListener('click', () => {
      sidebar.classList.add('open');
      overlay.classList.add('open');
    });
  }
  if (overlay) {
    overlay.addEventListener('click', () => {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
    });
  }

  // ==========================================================
  // ULINZI WA ROLE — kutoka Firestore: users/{uid}
  // Kama mtumiaji hajaingia au si admin → rudisha Home
  // ==========================================================
  async function guardAdmin() {
    const { onAuthStateChanged } = window.authFns;
    const { doc, getDoc } = window.fs;
    const auth = window.auth;
    const db   = window.db;

    onAuthStateChanged(auth, async (user) => {
      if (!user) {
        window.location.href = '/auth/login?redirect=' + encodeURIComponent(location.pathname);
        return;
      }

      try {
        // Angalia role kutoka Firestore
        const snap = await getDoc(doc(db, 'users', user.uid));
        const role = snap.exists() ? (snap.data().role || '') : '';

        if (role !== 'admin') {
          // Si admin — rudisha Home
          window.location.href = '/';
          return;
        }

        // Ni admin — jaza profile na onyesha sidebar
        const initial = (user.displayName || user.email || '?')
          .charAt(0).toUpperCase();
        const name = user.displayName || user.email.split('@')[0];

        document.getElementById('adminAvatar').textContent = initial;
        document.getElementById('adminName').textContent   = name;
        document.getElementById('adminGuard').style.display = 'none';
        sidebar.style.visibility = 'visible';

      } catch (err) {
        console.error('Admin guard error:', err);
        window.location.href = '/';
      }
    });
  }

  // ==========================================================
  // Logout — Firebase Auth + server session
  // ==========================================================
  async function initLogout() {
    const btn = document.getElementById('adminLogoutBtn');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      try {
        // 1. Server session
        await fetch('/auth/logout', { method: 'POST' });
      } catch (_) {}
      try {
        // 2. Firebase Auth
        await window.authFns.signOut(window.auth);
      } catch (_) {}
      window.location.href = '/';
    });
  }

  // ==========================================================
  // Anzisha — subiri Firebase iwe tayari
  // ==========================================================
  function boot() {
    guardAdmin();
    initLogout();
  }

  if (window.auth && window.fs) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
