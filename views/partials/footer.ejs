<!-- ==========================================================
     JAVASCRIPT YA FOOTER
     - Mwaka wa sasa (dynamic)
     - Newsletter → Firestore collection "subscribers" (data halisi)
     - Contact info → Firestore settings/site (kama ipo)
     ========================================================== -->
<script type="module">

  // ---------- 1. Mwaka wa sasa ----------
  const yearEl = document.getElementById('footerYear');
  if (yearEl) yearEl.textContent = new Date().getFullYear();

  // ==========================================================
  // 2. Newsletter → Firestore (subscribers collection)
  //    Hakuna data ya uongo. Kila email inasave kama document halisi.
  // ==========================================================
  async function initNewsletter() {
    const form = document.getElementById('newsletterForm');
    const msg = document.getElementById('newsletterMsg');
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('newsletterEmail');
      const email = emailInput.value.trim().toLowerCase();
      msg.className = 'newsletter-msg';
      msg.textContent = '';

      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.classList.add('err');
        msg.textContent = 'Tafadhali weka email sahihi.';
        return;
      }

      const btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Inatuma...';

      try {
        const { collection, doc, getDoc, setDoc, serverTimestamp } = window.fs;
        const db = window.db;

        // Tumia email kama document ID ili kuzuia duplicates
        const safeId = email.replace(/[^a-z0-9]/g, '_');
        const ref = doc(db, 'subscribers', safeId);
        const existing = await getDoc(ref);

        if (existing.exists()) {
          msg.classList.add('err');
          msg.textContent = 'Email hii tayari imejiunga.';
        } else {
          await setDoc(ref, {
            email,
            subscribedAt: serverTimestamp(),
            source: 'footer'
          });
          msg.classList.add('ok');
          msg.textContent = 'Asante! Umejiunga kikamilifu. ✅';
          emailInput.value = '';
        }
      } catch (err) {
        console.error('Newsletter error:', err);
        msg.classList.add('err');
        msg.textContent = 'Kuna tatizo. Jaribu tena baadaye.';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Jiunge';
      }
    });
  }

  // ==========================================================
  // 3. Contact info kutoka Firestore: settings/site
  //    Kama document haipo, inaacha "—" (hakuna data ya uongo)
  // ==========================================================
  async function initFooterContact() {
    const box = document.getElementById('footerContact');
    if (!box) return;
    try {
      const { doc, getDoc } = window.fs;
      const ref = doc(window.db, 'settings', 'site');
      const snap = await getDoc(ref);
      if (!snap.exists()) return; // hakuna settings, acha "—"

      const data = snap.data();
      const setVal = (field, value) => {
        const el = box.querySelector(`[data-field="${field}"] span`);
        if (el && value) el.textContent = value;
      };
      setVal('phone', data.phone);
      setVal('email', data.email);
      setVal('address', data.address);

      // Social links pia (kama zipo)
      if (data.social) {
        document.querySelectorAll('.social-btn').forEach((a) => {
          const key = a.dataset.social;
          if (data.social[key]) a.href = data.social[key];
        });
      }
    } catch (err) {
      console.error('Footer settings error:', err);
    }
  }

  // ==========================================================
  // 4. Anzisha — subiri Firebase iwe tayari
  // ==========================================================
  function bootFooter() {
    initNewsletter();
    initFooterContact();
  }

  if (window.fs && window.db) {
    bootFooter();
  } else {
    window.addEventListener('firebase-ready', bootFooter, { once: true });
  }
</script>
