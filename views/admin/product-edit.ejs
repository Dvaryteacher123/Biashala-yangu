<%- include('../partials/header', { title, description }) %>

<!-- ==========================================================
     ADMIN PRODUCT EDIT — Full Width Layout
     Firestore: products/{id} (getDoc + setDoc merge)
     Storage: uploadBytes (picha mpya)
     ========================================================== -->

<%- include('../partials/admin-sidebar') %>

<main class="admin-main">

  <!-- Topbar -->
  <div class="admin-topbar">
    <div class="topbar-left">
      <a href="/admin/products" class="back-link">← Rudi kwa Bidhaa</a>
      <h1>✏️ Badili Bidhaa</h1>
      <p class="topbar-sub" id="topbarSub">Inapakia...</p>
    </div>
    <div class="topbar-right">
      <a href="#" id="viewProductLink" target="_blank" class="btn btn-outline" style="display:none;">
        👁️ Ona Dukani
      </a>
    </div>
  </div>

  <!-- Loading -->
  <div id="editLoading" class="loading">
    <div class="spinner"></div> Inapakia bidhaa...
  </div>

  <!-- Not found -->
  <div id="editNotFound" class="empty-state" style="display:none;padding:60px 20px;">
    <h3>Bidhaa haipatikani</h3>
    <p>Bidhaa uliyoitafuta haipo au imeondolewa.</p>
    <a href="/admin/products" class="btn btn-primary" style="margin-top:14px;">Rudi kwa Bidhaa</a>
  </div>

  <!-- Form -->
  <form id="productForm" class="prod-form" novalidate style="display:none;">

    <div class="form-layout">

      <!-- ============ Kushoto: Info ============ -->
      <div class="form-col-main">

        <!-- Basic info -->
        <div class="form-card">
          <h3>📝 Taarifa za Msingi</h3>

          <div class="field">
            <label for="pName">Jina la Bidhaa *</label>
            <input type="text" id="pName" required />
          </div>

          <div class="field">
            <label for="pDesc">Maelezo *</label>
            <textarea id="pDesc" rows="5" required></textarea>
          </div>

          <div class="field-grid">
            <div class="field">
              <label for="pCategory">Kundi *</label>
              <select id="pCategory" required>
                <option value="">— Inapakia makundi —</option>
              </select>
            </div>

            <div class="field">
              <label for="pStock">Stoko *</label>
              <input type="number" id="pStock" min="0" required />
            </div>
          </div>

          <div class="field-grid">
            <div class="field">
              <label for="pPrice">Bei (TSh) *</label>
              <input type="number" id="pPrice" min="0" step="100" required />
            </div>
            <div class="field">
              <label for="pOldPrice">Bei ya Awali (hiari)</label>
              <input type="number" id="pOldPrice" min="0" step="100" />
            </div>
          </div>
        </div>

        <!-- Images -->
        <div class="form-card">
          <h3>🖼️ Picha za Bidhaa</h3>

          <!-- Existing + new images -->
          <div class="preview-grid" id="previewGrid"></div>

          <!-- Upload new -->
          <div class="field" style="margin-top:14px;">
            <label>Ongeza Picha Mpya</label>
            <div class="upload-zone" id="uploadZone">
              <input type="file" id="fileInput" accept="image/*" multiple hidden />
              <div class="upload-inner">
                <div class="upload-icon">📸</div>
                <p><strong>Bonyeza</strong> kuchagua picha au buruta hapa</p>
                <p class="upload-hint">PNG, JPG, WEBP — max 5MB kwa picha</p>
              </div>
            </div>
          </div>

          <details class="url-details">
            <summary>Au weka URL ya picha</summary>
            <div class="field" style="margin-top:12px;">
              <input type="url" id="pImageUrl" placeholder="https://..." />
            </div>
          </details>
        </div>

        <!-- Variants -->
        <div class="form-card">
          <h3>🎨 Ukubwa na Rangi</h3>

          <div class="field">
            <label>Ukubwa Unaopatikana</label>
            <div class="chips-input">
              <div class="chips" id="sizesChips"></div>
              <div class="chips-input-row">
                <input type="text" id="sizeInput" placeholder="Mfano: S, M, L, XL" />
                <button type="button" class="btn-add-chip" id="addSizeBtn">➕</button>
              </div>
              <div class="chip-suggestions">
                <button type="button" class="chip-suggest" data-size="XS">XS</button>
                <button type="button" class="chip-suggest" data-size="S">S</button>
                <button type="button" class="chip-suggest" data-size="M">M</button>
                <button type="button" class="chip-suggest" data-size="L">L</button>
                <button type="button" class="chip-suggest" data-size="XL">XL</button>
                <button type="button" class="chip-suggest" data-size="XXL">XXL</button>
              </div>
            </div>
          </div>

          <div class="field">
            <label>Rangi Zinazopatikana</label>
            <div class="chips-input">
              <div class="chips" id="colorsChips"></div>
              <div class="chips-input-row">
                <input type="text" id="colorInput" placeholder="Mfano: Nyeusi, Nyeupe, Blu" />
                <button type="button" class="btn-add-chip" id="addColorBtn">➕</button>
              </div>
              <div class="chip-suggestions">
                <button type="button" class="chip-suggest" data-color="Nyeusi">Nyeusi</button>
                <button type="button" class="chip-suggest" data-color="Nyeupe">Nyeupe</button>
                <button type="button" class="chip-suggest" data-color="Bluu">Bluu</button>
                <button type="button" class="chip-suggest" data-color="Nyekundu">Nyekundu</button>
                <button type="button" class="chip-suggest" data-color="Kijani">Kijani</button>
                <button type="button" class="chip-suggest" data-color="Kijivu">Kijivu</button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- ============ Kulia: Sidebar ============ -->
      <aside class="form-col-side">

        <!-- Save -->
        <div class="form-card">
          <h3>💾 Hifadhi</h3>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-full" id="saveBtn">
              💾 Hifadhi Mabadiliko
            </button>
            <a href="/admin/products" class="btn btn-ghost btn-full">Ghairi</a>
          </div>
          <p id="formMsg" class="alert" style="display:none;"></p>
        </div>

        <!-- Options -->
        <div class="form-card">
          <h3>⚙️ Chaguzi</h3>

          <label class="check-row">
            <input type="checkbox" id="pFeatured" />
            <div>
              <strong>Featured</strong>
              <small>Onyesha kwenye ukurasa wa nyumbani</small>
            </div>
          </label>

          <label class="check-row">
            <input type="checkbox" id="pActive" checked />
            <div>
              <strong>Inaonekana dukani</strong>
              <small>Wateja wanaweza kuiona na kuinunua</small>
            </div>
          </label>
        </div>

        <!-- Meta -->
        <div class="form-card">
          <h3>ℹ️ Taarifa</h3>
          <div class="meta-list">
            <div class="meta-row">
              <span class="meta-label">ID ya Bidhaa</span>
              <span class="meta-value mono" id="metaId">—</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Iliundwa</span>
              <span class="meta-value" id="metaCreated">—</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Ilisasishwa</span>
              <span class="meta-value" id="metaUpdated">—</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">Hali</span>
              <span class="meta-value" id="metaStatus">—</span>
            </div>
          </div>
        </div>

        <!-- Preview -->
        <div class="form-card">
          <h3>👁️ Onyesho</h3>
          <div class="product-preview">
            <div class="pv-image" id="pvImage">
              <span>Hakuna picha</span>
            </div>
            <div class="pv-info">
              <div class="pv-name" id="pvName">Jina la bidhaa</div>
              <div class="pv-price" id="pvPrice">TSh 0</div>
              <div class="pv-cat" id="pvCat" style="display:none;"></div>
            </div>
          </div>
        </div>

        <!-- Danger zone -->
        <div class="form-card danger-card">
          <h3 style="color:#c62828;">⚠️ Eneo la Hatari</h3>
          <p class="danger-text">Kufuta bidhaa hii hakuwezi kurudishwa.</p>
          <button type="button" class="btn btn-danger btn-full" id="deleteBtn">
            🗑️ Futa Bidhaa
          </button>
        </div>

      </aside>

    </div>

  </form>
</main>

<!-- ==========================================================
     CSS YA ADMIN PRODUCT EDIT
     ========================================================== -->
<style>
  body { background: #f4f5f7; }

  .admin-main {
    margin-left: 250px;
    padding: 26px 30px 50px;
    min-height: 100vh;
    width: calc(100% - 250px);
    box-sizing: border-box;
  }

  /* ---------- Topbar ---------- */
  .admin-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e6e6eb;
  }
  .back-link {
    display: inline-block;
    color: #e63946;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .back-link:hover { text-decoration: underline; }
  .topbar-left h1 {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin-bottom: 4px;
  }
  .topbar-sub { color: #777; font-size: 13px; }
  .topbar-right { display: flex; gap: 10px; }

  /* ---------- Form Layout ---------- */
  .form-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 22px;
    align-items: start;
  }
  .form-col-main { display: flex; flex-direction: column; gap: 20px; }
  .form-col-side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 20px; }

  /* ---------- Form cards ---------- */
  .form-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    padding: 22px;
  }
  .form-card h3 {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0f0f3;
  }
  .form-card.danger-card {
    border: 1.5px dashed #f7c8cd;
  }
  .danger-text {
    color: #666;
    font-size: 13px;
    margin-bottom: 12px;
    line-height: 1.5;
  }

  /* Fields */
  .field { margin-bottom: 16px; }
  .field:last-child { margin-bottom: 0; }
  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: #fafafc;
    transition: border-color 0.15s, background 0.15s;
    box-sizing: border-box;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: #111;
    background: #fff;
  }
  .field textarea { resize: vertical; }
  .field-hint {
    display: block;
    color: #888;
    font-size: 12px;
    margin-top: 5px;
    line-height: 1.5;
  }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  /* Upload Zone */
  .upload-zone {
    border: 2px dashed #d0d0d8;
    border-radius: 12px;
    padding: 24px 20px;
    text-align: center;
    cursor: pointer;
    background: #fafafc;
    transition: all 0.15s;
  }
  .upload-zone:hover,
  .upload-zone.dragover {
    border-color: #111;
    background: #f2f2f5;
  }
  .upload-icon { font-size: 30px; margin-bottom: 8px; }
  .upload-inner p { color: #333; font-size: 13px; margin-bottom: 3px; }
  .upload-hint { color: #999 !important; font-size: 12px !important; }

  /* Preview grid */
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 10px;
  }
  .preview-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    background: #f2f2f5;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    cursor: pointer;
  }
  .preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .preview-item .pv-remove {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(0,0,0,0.65);
    color: #fff;
    font-size: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .preview-item .pv-remove:hover { background: #dc3545; }
  .preview-item .pv-cover {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: #111;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }
  .preview-item.is-cover {
    outline: 3px solid #111;
    outline-offset: 2px;
  }
  .preview-item .pv-new {
    position: absolute;
    top: 6px;
    left: 6px;
    background: #2e7d32;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  /* URL details */
  .url-details {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid #f0f0f3;
  }
  .url-details summary {
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: #555;
    padding: 4px 0;
  }

  /* Chips */
  .chips-input {
    background: #fafafc;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    padding: 12px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
    min-height: 24px;
  }
  .chips:empty::before {
    content: 'Hakuna bado';
    color: #bbb;
    font-size: 13px;
  }
  .chip-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #111;
    color: #fff;
    padding: 5px 10px;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 600;
  }
  .chip-item button {
    background: transparent;
    color: #fff;
    font-size: 14px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .chip-item button:hover { background: rgba(255,255,255,0.2); }

  .chips-input-row { display: flex; gap: 8px; }
  .chips-input-row input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid #e0e0e5;
    border-radius: 6px;
    font-size: 13px;
    outline: none;
    background: #fff;
    font-family: inherit;
  }
  .chips-input-row input:focus { border-color: #111; }

  .btn-add-chip {
    padding: 0 14px;
    background: #111;
    color: #fff;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }
  .btn-add-chip:hover { background: #333; }

  .chip-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #f0f0f3;
  }
  .chip-suggest {
    background: #fff;
    border: 1px solid #e0e0e5;
    border-radius: 14px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
    color: #555;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
  }
  .chip-suggest:hover {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    border: none;
  }
  .btn-full { width: 100%; }
  .btn-primary { background: #111; color: #fff; }
  .btn-primary:hover:not(:disabled) { background: #333; }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-outline {
    background: #fff;
    color: #333;
    border: 1.5px solid #e0e0e5;
  }
  .btn-outline:hover { background: #f2f2f5; }
  .btn-ghost {
    background: transparent;
    color: #888;
    font-weight: 500;
  }
  .btn-ghost:hover { color: #111; background: #f2f2f5; }
  .btn-danger {
    background: #dc3545;
    color: #fff;
  }
  .btn-danger:hover { background: #c82333; }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Options */
  .check-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px;
    border-radius: 8px;
    background: #fafafc;
    cursor: pointer;
    margin-bottom: 8px;
    transition: background 0.15s;
  }
  .check-row:last-child { margin-bottom: 0; }
  .check-row:hover { background: #f2f2f5; }
  .check-row input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    cursor: pointer;
    accent-color: #111;
