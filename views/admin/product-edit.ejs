    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    padding-bottom: 10px;
    border-bottom: 1px solid #f4f4f6;
  }
  .meta-row:last-child { border-bottom: none; padding-bottom: 0; }
  .meta-label { color: #888; flex-shrink: 0; }
  .meta-value {
    color: #111;
    font-weight: 600;
    text-align: right;
    word-break: break-all;
    min-width: 0;
  }
  .meta-value.mono {
    font-family: 'SF Mono', Menlo, monospace;
    font-size: 12px;
    font-weight: 500;
  }

  /* Preview */
  .product-preview {
    background: #fafafc;
    border-radius: 10px;
    overflow: hidden;
  }
  .pv-image {
    width: 100%;
    aspect-ratio: 1;
    background: #f2f2f5;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #bbb;
    font-size: 13px;
    background-size: cover;
    background-position: center;
  }
  .pv-info { padding: 12px; }
  .pv-name {
    font-size: 14px;
    font-weight: 600;
    color: #111;
    margin-bottom: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pv-price {
    font-size: 15px;
    font-weight: 800;
    color: #e63946;
  }
  .pv-cat {
    display: inline-block;
    margin-top: 6px;
    background: #fff;
    color: #666;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 10px;
  }

  /* Alert */
  .alert {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 13px;
    margin-top: 12px;
    line-height: 1.5;
  }
  .alert-error   { background: #fdecea; color: #b71c1c; }
  .alert-success { background: #e8f5e9; color: #1b5e20; }
  .alert-info    { background: #e3f2fd; color: #0d47a1; }

  /* ---------- Responsive ---------- */
  @media (max-width: 1000px) {
    .form-layout { grid-template-columns: 1fr; }
    .form-col-side { position: static; }
  }
  @media (max-width: 900px) {
    .admin-main {
      margin-left: 0;
      width: 100%;
      padding: 70px 14px 40px;
    }
    .field-grid { grid-template-columns: 1fr; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA PRODUCT EDIT — Firestore halisi
     ========================================================== -->
<script type="module">

  // Product ID kutoka routes/admin.routes.js
  const PRODUCT_ID = "<%= productId %>";

  // State
  const state = {
    product: null,     // original document
    images: [],        // [{ url, isNew, isUploaded, file?, external? }]
    sizes: [],
    colors: [],
    submitting: false
  };

  const form = document.getElementById('productForm');
  const msg  = document.getElementById('formMsg');

  // ==========================================================
  // Helpers
  // ==========================================================
  function showMsg(text, type = 'error') {
    msg.textContent = text;
    msg.className = 'alert alert-' + (type === 'success' ? 'success' : type === 'info' ? 'info' : 'error');
    msg.style.display = 'block';
    msg.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  function hideMsg() { msg.style.display = 'none'; }

  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function fmtDate(ts) {
    if (!ts) return '—';
    let d = ts;
    if (typeof ts === 'object' && ts.seconds) d = new Date(ts.seconds * 1000);
    else if (typeof ts === 'string') d = new Date(ts);
    if (isNaN(d)) return '—';
    return d.toLocaleString('sw-TZ', {
      day: 'numeric', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit'
    });
  }

  // ==========================================================
  // 1. Pakia categories kwenye select
  // ==========================================================
  async function loadCategories(selectedId) {
    const sel = document.getElementById('pCategory');
    try {
      const { collection, getDocs, query, orderBy } = window.fs;
      let snap;
      try {
        snap = await getDocs(query(collection(window.db, 'categories'), orderBy('name')));
      } catch {
        snap = await getDocs(collection(window.db, 'categories'));
      }

      sel.innerHTML = '<option value="">— Chagua Kundi —</option>';
      snap.forEach((d) => {
        const c = d.data();
        const opt = document.createElement('option');
        opt.value = d.id;
        opt.textContent = c.name || d.id;
        sel.appendChild(opt);
      });

      if (selectedId) sel.value = selectedId;
    } catch (err) {
      console.error('Load categories error:', err);
    }
  }

  // ==========================================================
  // 2. Pakia bidhaa kutoka Firestore: products/{id}
  // ==========================================================
  async function loadProduct() {
    const loading = document.getElementById('editLoading');
    const notFound = document.getElementById('editNotFound');

    try {
      const { doc, getDoc } = window.fs;
      const snap = await getDoc(doc(window.db, 'products', PRODUCT_ID));

      loading.style.display = 'none';

      if (!snap.exists()) {
        notFound.style.display = 'block';
        return;
      }

      state.product = { id: snap.id, ...snap.data() };
      prefillForm(state.product);
      form.style.display = 'block';

    } catch (err) {
      console.error('Load product error:', err);
      loading.style.display = 'none';
      notFound.style.display = 'block';
    }
  }

  // ==========================================================
  // 3. Prefill form
  // ==========================================================
  function prefillForm(p) {
    document.getElementById('pName').value  = p.name || '';
    document.getElementById('pDesc').value  = p.description || '';
    document.getElementById('pStock').value = Number(p.stock || 0);
    document.getElementById('pPrice').value = Number(p.price || 0);
    document.getElementById('pOldPrice').value = p.oldPrice || '';
    document.getElementById('pFeatured').checked = !!p.featured;
    document.getElementById('pActive').checked = p.active !== false; // default true

    // Categories — pakia kisha weka selected
    loadCategories(p.category || '');

    // Sizes + colors
    state.sizes  = Array.isArray(p.sizes)  ? [...p.sizes]  : [];
    state.colors = Array.isArray(p.colors) ? [...p.colors] : [];
    renderChips('sizes');
    renderChips('colors');

    // Images — cover kwanza, kisha zilizobaki
    state.images = [];
    if (p.image) {
      state.images.push({ url: p.image, isNew: false, isUploaded: true });
    }
    if (Array.isArray(p.images)) {
      p.images.forEach((url) => {
        if (url && url !== p.image) {
          state.images.push({ url, isNew: false, isUploaded: true });
        }
      });
    }
    renderPreviews();

    // Topbar
    document.getElementById('topbarSub').textContent =
      `ID: ${p.id}`;
    document.getElementById('viewProductLink').href = `/product/${p.id}`;
    document.getElementById('viewProductLink').style.display = 'inline-flex';

    // Meta
    document.getElementById('metaId').textContent = p.id;
    document.getElementById('metaCreated').textContent = fmtDate(p.createdAt);
    document.getElementById('metaUpdated').textContent = fmtDate(p.updatedAt);
    document.getElementById('metaStatus').textContent = p.status || 'published';

    // Live preview update
    updateLivePreview();
  }

  // ==========================================================
  // 4. Images — Upload Zone
  // ==========================================================
  function bindUploadZone() {
    const zone = document.getElementById('uploadZone');
    const input = document.getElementById('fileInput');

    zone.addEventListener('click', () => input.click());

    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('dragover');
    });
    zone.addEventListener('dragleave', () => zone.classList.remove('dragover'));
    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('dragover');
      handleFiles(e.dataTransfer.files);
    });

    input.addEventListener('change', (e) => {
      handleFiles(e.target.files);
      input.value = '';
    });
  }

  function handleFiles(files) {
    if (!files || files.length === 0) return;
    const maxSize = 5 * 1024 * 1024;

    Array.from(files).forEach((file) => {
      if (!file.type.startsWith('image/')) {
        showMsg(`"${file.name}" si picha.`); return;
      }
      if (file.size > maxSize) {
        showMsg(`"${file.name}" ni kubwa sana (max 5MB).`); return;
      }
      const reader = new FileReader();
      reader.onload = (ev) => {
        state.images.push({
          file,
          url: ev.target.result,
          isNew: true,
          isUploaded: false
        });
        renderPreviews();
      };
      reader.readAsDataURL(file);
    });
  }

  function bindUrlInput() {
    const urlInput = document.getElementById('pImageUrl');
    let timer;
    urlInput.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        const url = urlInput.value.trim();
        if (!url || !/^https?:\/\//i.test(url)) return;
        state.images.push({ url, isNew: true, isUploaded: true, external: true });
        renderPreviews();
        urlInput.value = '';
      }, 400);
    });
  }

  function renderPreviews() {
    const grid = document.getElementById('previewGrid');
    if (state.images.length === 0) {
      grid.innerHTML = '<p style="color:#999;font-size:13px;padding:14px;text-align:center;grid-column:1/-1;">Hakuna picha. Ongeza angalau moja.</p>';
      updateMainPreview();
      return;
    }
    grid.innerHTML = state.images.map((img, i) => `
      <div class="preview-item ${i === 0 ? 'is-cover' : ''}" data-i="${i}" title="Bonyeza kuweka kama cover">
        <img src="${img.url}" alt="Preview ${i + 1}" />
        ${img.isNew ? '<span class="pv-new">Mpya</span>' : ''}
        ${i === 0 ? '<span class="pv-cover">Cover</span>' : ''}
        <button type="button" class="pv-remove" data-remove="${i}">✕</button>
      </div>
    `).join('');

    grid.querySelectorAll('[data-remove]').forEach((b) => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        state.images.splice(Number(b.dataset.remove), 1);
        renderPreviews();
      });
    });

    grid.querySelectorAll('.preview-item').forEach((el) => {
      el.addEventListener('click', (e) => {
        if (e.target.closest('.pv-remove')) return;
        const i = Number(el.dataset.i);
        if (i === 0) return;
        const [img] = state.images.splice(i, 1);
        state.images.unshift(img);
        renderPreviews();
      });
    });

    updateMainPreview();
  }

  function updateMainPreview() {
    const pv = document.getElementById('pvImage');
    if (state.images.length > 0) {
      pv.style.backgroundImage = `url('${state.images[0].url}')`;
      pv.innerHTML = '';
    } else {
      pv.style.backgroundImage = '';
      pv.innerHTML = '<span>Hakuna picha</span>';
    }
  }

  // ==========================================================
  // 5. Chips
  // ==========================================================
  function bindChips() {
    const addSize = () => {
      const input = document.getElementById('sizeInput');
      const v = input.value.trim();
      if (!v) return;
      v.split(',').map((s) => s.trim()).filter(Boolean).forEach((s) => {
        if (!state.sizes.includes(s)) state.sizes.push(s);
      });
      input.value = '';
      renderChips('sizes');
    };
    document.getElementById('addSizeBtn').addEventListener('click', addSize);
    document.getElementById('sizeInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); addSize(); }
    });
    document.querySelectorAll('[data-size]').forEach((b) => {
      b.addEventListener('click', () => {
        const s = b.dataset.size;
        if (!state.sizes.includes(s)) { state.sizes.push(s); renderChips('sizes'); }
      });
    });

    const addColor = () => {
      const input = document.getElementById('colorInput');
      const v = input.value.trim();
      if (!v) return;
      v.split(',').map((c) => c.trim()).filter(Boolean).forEach((c) => {
        if (!state.colors.includes(c)) state.colors.push(c);
      });
      input.value = '';
      renderChips('colors');
    };
    document.getElementById('addColorBtn').addEventListener('click', addColor);
    document.getElementById('colorInput').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { e.preventDefault(); addColor(); }
    });
    document.querySelectorAll('[data-color]').forEach((b) => {
      b.addEventListener('click', () => {
        const c = b.dataset.color;
        if (!state.colors.includes(c)) { state.colors.push(c); renderChips('colors'); }
      });
    });
  }

  function renderChips(type) {
    const isSize = type === 'sizes';
    const arr = isSize ? state.sizes : state.colors;
    const container = document.getElementById(isSize ? 'sizesChips' : 'colorsChips');

    container.innerHTML = arr.map((v, i) => `
      <span class="chip-item">
        ${escapeHtml(v)}
        <button type="button" data-chip="${type}" data-i="${i}">✕</button>
      </span>
    `).join('');

    container.querySelectorAll('[data-chip]').forEach((b) => {
      b.addEventListener('click', () => {
        const arr2 = b.dataset.chip === 'sizes' ? state.sizes : state.colors;
        arr2.splice(Number(b.dataset.i), 1);
        renderChips(type);
      });
    });
  }

  // ==========================================================
  // 6. Live preview
  // ==========================================================
  function updateLivePreview() {
    document.getElementById('pvName').textContent =
      document.getElementById('pName').value.trim() || 'Jina la bidhaa';
    const price = Number(document.getElementById('pPrice').value || 0);
    document.getElementById('pvPrice').textContent = `TSh ${price.toLocaleString()}`;

    const catEl = document.getElementById('pCategory');
    const catLabel = catEl.options[catEl.selectedIndex]?.text || '';
    const pvCat = document.getElementById('pvCat');
    if (catEl.value && catLabel !== '— Chagua Kundi —') {
      pvCat.textContent = catLabel;
      pvCat.style.display = 'inline-block';
    } else {
      pvCat.style.display = 'none';
    }
  }

  function bindLivePreview() {
    document.getElementById('pName').addEventListener('input', updateLivePreview);
    document.getElementById('pPrice').addEventListener('input', updateLivePreview);
    document.getElementById('pCategory').addEventListener('change', updateLivePreview);
  }

  // ==========================================================
  // 7. Upload picha mpya Storage
  // ==========================================================
  async function uploadNewImages() {
    const urls = [];
    const { storageRef, uploadBytes, getDownloadURL } = window.storageFns;

    for (const img of state.images) {
      if (img.isUploaded || img.external) {
        urls.push(img.url);
        continue;
      }
      const ext = (img.file.name.split('.').pop() || 'jpg').toLowerCase();
      const fileName = `products/${Date.now()}_${Math.random().toString(36).slice(2, 8)}.${ext}`;
      const ref = storageRef(window.storage, fileName);
      await uploadBytes(ref, img.file);
      const url = await getDownloadURL(ref);
      urls.push(url);
      img.url = url;
      img.isUploaded = true;
    }
    return urls;
  }

  // ==========================================================
  // 8. Submit (save changes)
  // ==========================================================
  function bindSubmit() {
    const saveBtn = document.getElementById('saveBtn');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (state.submitting) return;
      hideMsg();

      const name     = document.getElementById('pName').value.trim();
      const desc     = document.getElementById('pDesc').value.trim();
      const category = document.getElementById('pCategory').value;
      const stock    = Number(document.getElementById('pStock').value || 0);
      const price    = Number(document.getElementById('pPrice').value || 0);
      const oldPriceRaw = document.getElementById('pOldPrice').value;
      const oldPrice = oldPriceRaw ? Number(oldPriceRaw) : null;
      const featured = document.getElementById('pFeatured').checked;
      const active   = document.getElementById('pActive').checked;
      const catName  = document.getElementById('pCategory').selectedOptions[0]?.text || '';

      // Validation
      if (!name || name.length < 3) { showMsg('Jina liwe herufi 3+.'); return; }
      if (!desc || desc.length < 10) { showMsg('Maelezo yawe herufi 10+.'); return; }
      if (!category) { showMsg('Chagua kundi.'); return; }
      if (isNaN(price) || price <= 0) { showMsg('Bei iwe zaidi ya 0.'); return; }
      if (oldPrice != null && oldPrice <= price) {
        showMsg('Bei ya awali iwe kubwa kuliko bei ya sasa.'); return;
      }
      if (stock < 0) { showMsg('Stoko isiwe chini ya 0.'); return; }
      if (state.images.length === 0) { showMsg('Ongeza picha angalau moja.'); return; }

      state.submitting = true;
      saveBtn.disabled = true;
      const originalText = saveBtn.textContent;

      try {
        // 1. Upload picha mpya (kama zipo)
        let imageUrls = [];
        const hasNewFiles = state.images.some((img) => img.isNew && !img.isUploaded && !img.external);
        if (hasNewFiles) {
          saveBtn.textContent = 'Inapakia picha...';
          try {
            imageUrls = await uploadNewImages();
          } catch (upErr) {
            console.error('Upload error:', upErr);
            showMsg('Imeshindikana kupakia picha. Angalia Storage Rules.');
            state.submitting = false;
            saveBtn.disabled = false;
            saveBtn.textContent = originalText;
            return;
          }
        } else {
          imageUrls = state.images.map((img) => img.url);
        }

        // 2. Update Firestore
        saveBtn.textContent = 'Inahifadhi...';
        const { doc, setDoc, serverTimestamp } = window.fs;

        const update = {
          name,
          description: desc,
          price,
          oldPrice: oldPrice || null,
          stock,
          category,
          categoryName: catName,
          sizes: state.sizes,
          colors: state.colors,
          image: imageUrls[0] || '',
          images: imageUrls,
          featured,
          active,
          updatedAt: serverTimestamp()
        };

        await setDoc(doc(window.db, 'products', PRODUCT_ID), update, { merge: true });

        showMsg('✅ Mabadiliko yamehifadhiwa! Tunakupeleka...', 'success');

        setTimeout(() => {
          window.location.href = '/admin/products';
        }, 700);

      } catch (err) {
        console.error('Save error:', err);
        showMsg('Imeshindikana kuhifadhi. Jaribu tena.');
        state.submitting = false;
        saveBtn.disabled = false;
        saveBtn.textContent = originalText;
      }
    });
  }

  // ==========================================================
  // 9. Delete bidhaa
  // ==========================================================
  function bindDelete() {
    document.getElementById('deleteBtn').addEventListener('click', async () => {
      const name = state.product?.name || PRODUCT_ID;
      if (!confirm(`Una uhakika unataka kufuta "${name}"? Hii haiwezi kurudishwa.`)) return;

      try {
        const { doc, deleteDoc } = window.fs;
        await deleteDoc(doc(window.db, 'products', PRODUCT_ID));
        window.location.href = '/admin/products';
      } catch (err) {
        console.error('Delete error:', err);
        alert('Imeshindikana kufuta. Jaribu tena.');
      }
    });
  }

  // ==========================================================
  // 10. Boot
  // ==========================================================
  function boot() {
    bindUploadZone();
    bindUrlInput();
    bindChips();
    bindLivePreview();
    bindSubmit();
    bindDelete();
    loadProduct();
  }

  if (window.fs && window.db && window.storage && window.storageFns) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
