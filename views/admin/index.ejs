  }
  .stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    flex-shrink: 0;
  }
  .stat-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .stat-label {
    color: #777;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 3px;
  }
  .stat-num {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    line-height: 1.1;
  }
  .stat-sub {
    color: #888;
    font-size: 12px;
    margin-top: 3px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    margin-bottom: 26px;
  }
  @media (max-width: 1000px) {
    .grid-2 { grid-template-columns: 1fr; }
  }

  .panel {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    padding: 20px;
    display: flex;
    flex-direction: column;
  }
  .panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0f0f3;
    flex-wrap: wrap;
  }
  .panel-head h3 {
    font-size: 15px;
    font-weight: 700;
    color: #111;
  }
  .panel-link {
    color: #e63946;
    font-size: 13px;
    font-weight: 600;
  }
  .panel-link:hover { text-decoration: underline; }

  .chart-wrap {
    flex: 1;
    min-height: 200px;
  }
  .chart {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    height: 200px;
    padding: 10px 4px 0;
  }
  .bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    height: 100%;
    justify-content: flex-end;
  }
  .bar {
    width: 100%;
    max-width: 42px;
    background: linear-gradient(180deg, #111 0%, #333 100%);
    border-radius: 6px 6px 0 0;
    min-height: 4px;
    transition: height 0.4s ease, background 0.15s;
    position: relative;
