  .recent-item {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 10px 8px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
    border-bottom: 1px solid #f7f7f9;
