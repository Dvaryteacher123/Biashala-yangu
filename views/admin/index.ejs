  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: #111;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    max-height: 320px;
    overflow-y: auto;
