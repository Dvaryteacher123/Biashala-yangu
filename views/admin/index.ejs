    white-space: nowrap;
  }
  .ri-right {
    text-align: right;
    flex-shrink: 0;
  }
  .ri-amount {
    font-size: 13px;
    font-weight: 700;
    color: #e63946;
  }
  .ri-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    text-transform: capitalize;
    margin-top: 3px;
  }
  .ri-badge.pending    { background: #fff3cd; color: #856404; }
  .ri-badge.processing { background: #cfe2ff; color: #084298; }
  .ri-badge.shipped    { background: #e3f2fd; color: #0d47a1; }
  .ri-badge.delivered  { background: #e8f5e9; color: #1b5e20; }
  .ri-badge.cancelled  { background: #fdecea; color: #b71c1c; }

  .ri-stock-warn { color: #c62828; font-size: 12px; font-weight: 700; }
  .ri-stock-ok   { color: #888; font-size: 11px; }

  .muted {
    color: #999;
    font-size: 13px;
    text-align: center;
    padding: 30px 20px;
  }

  .quick-actions {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    padding: 20px;
  }
  .quick-actions h3 {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f0f0f3;
  }
  .qa-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
  }
  .qa-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 20px 10px;
    background: #fafafc;
    border-radius: 10px;
    transition: background 0.15s, transform 0.15s;
    text-decoration: none;
  }
  .qa-card:hover {
    background: #f0f0f3;
    transform: translateY(-2px);
  }
  .qa-icon {
    font-size: 26px;
  }
  .qa-label {
    font-size: 13px;
    font-weight: 600;
    color: #333;
