<%- include('../partials/header', { title, description }) %>

<!-- ==========================================================
     ADMIN DASHBOARD — Full Width Layout
     Sidebar fixed (250px), content inatumia nafasi iliyobaki
     ========================================================== -->

<!-- Sidebar ya admin -->
<%- include('../partials/admin-sidebar') %>

<!-- ============ MAIN CONTENT (Full Width) ============ -->
<main class="admin-main">

  <!-- Topbar -->
  <div class="admin-topbar">
    <div class="topbar-left">
      <h1>📊 Dashboard</h1>
      <p class="topbar-sub">Muhtasari wa duka lako kwa wakati halisi</p>
    </div>
    <div class="topbar-right">
      <span class="live-dot"></span>
      <span class="live-text" id="lastUpdate">Inapakia...</span>
      <button class="btn-refresh" id="refreshBtn" title="Refresh">🔄</button>
    </div>
  </div>

  <!-- Loading -->
  <div id="dashLoading" class="loading">
    <div class="spinner"></div> Inapakia takwimu...
  </div>

  <!-- Content -->
  <div id="dashContent" style="display:none;">

    <!-- ============ STATS CARDS ============ -->
    <section class="stats-grid">

      <div class="stat-card">
        <div class="stat-icon" style="background:#e3f2fd;color:#0d47a1;">👕</div>
        <div class="stat-body">
          <span class="stat-label">Bidhaa</span>
          <span class="stat-num" id="statProducts">0</span>
          <span class="stat-sub" id="statProductsSub">—</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="background:#fff3cd;color:#856404;">🧾</div>
        <div class="stat-body">
          <span class="stat-label">Oda Zote</span>
          <span class="stat-num" id="statOrders">0</span>
          <span class="stat-sub" id="statOrdersSub">—</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="background:#e8f5e9;color:#1b5e20;">💰</div>
        <div class="stat-body">
          <span class="stat-label">Mapato (Jumla)</span>
          <span class="stat-num" id="statRevenue">TSh 0</span>
          <span class="stat-sub" id="statRevenueSub">—</span>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon" style="background:#f3e5f5;color:#4a148c;">👥</div>
        <div class="stat-body">
          <span class="stat-label">Wateja</span>
          <span class="stat-num" id="statCustomers">0</span>
          <span class="stat-sub" id="statCustomersSub">—</span>
        </div>
      </div>

    </section>

    <!-- ============ CHART + RECENT ORDERS ============ -->
    <section class="grid-2">

      <!-- Chart: mauzo siku 7 -->
      <div class="panel">
        <div class="panel-head">
          <h3>📈 Mauzo (Siku 7 Zilizopita)</h3>
        </div>
        <div class="chart-wrap">
          <div class="chart" id="salesChart"></div>
        </div>
        <div class="chart-legend">
          <span class="legend-dot"></span> Mapato kwa siku
        </div>
      </div>

      <!-- Recent Orders -->
      <div class="panel">
        <div class="panel-head">
          <h3>🧾 Oda za Hivi Karibuni</h3>
          <a href="/admin/orders" class="panel-link">Zote →</a>
        </div>
        <div class="recent-list" id="recentOrders">
          <p class="muted">Inapakia...</p>
        </div>
      </div>

    </section>

    <!-- ============ LOW STOCK + RECENT MESSAGES ============ -->
    <section class="grid-2">

      <!-- Low stock alerts -->
      <div class="panel">
        <div class="panel-head">
          <h3>⚠️ Bidhaa Zinazoisha Stokini</h3>
          <a href="/admin/inventory" class="panel-link">Stoko →</a>
        </div>
        <div class="recent-list" id="lowStockList">
          <p class="muted">Inapakia...</p>
        </div>
      </div>

      <!-- Recent Messages -->
      <div class="panel">
        <div class="panel-head">
          <h3>📧 Ujumbe wa Hivi Karibuni</h3>
          <a href="/admin/messages" class="panel-link">Zote →</a>
        </div>
        <div class="recent-list" id="recentMessages">
          <p class="muted">Inapakia...</p>
        </div>
      </div>

    </section>

    <!-- ============ QUICK ACTIONS ============ -->
    <section class="quick-actions">
      <h3>Vitendo vya Haraka</h3>
      <div class="qa-grid">
        <a href="/admin/products/add" class="qa-card">
          <span class="qa-icon">➕</span>
          <span class="qa-label">Ongeza Bidhaa</span>
        </a>
        <a href="/admin/orders" class="qa-card">
          <span class="qa-icon">🧾</span>
          <span class="qa-label">Angalia Oda</span>
        </a>
        <a href="/admin/customers" class="qa-card">
          <span class="qa-icon">👥</span>
          <span class="qa-label">Wateja</span>
        </a>
        <a href="/admin/coupons" class="qa-card">
          <span class="qa-icon">🎟️</span>
          <span class="qa-label">Punguzo</span>
        </a>
        <a href="/admin/banners" class="qa-card">
          <span class="qa-icon">🖼️</span>
          <span class="qa-label">Mabango</span>
        </a>
        <a href="/admin/settings" class="qa-card">
          <span class="qa-icon">⚙️</span>
          <span class="qa-label">Mipangilio</span>
        </a>
      </div>
    </section>

  </div>
</main>

<!-- ==========================================================
     CSS YA ADMIN DASHBOARD (full width)
     ========================================================== -->
<style>
  body {
    background: #f4f5f7;
  }

  .admin-main {
    margin-left: 250px;
    padding: 26px 30px 50px;
    min-height: 100vh;
    width: calc(100% - 250px);
    box-sizing: border-box;
  }

  .admin-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 26px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e6e6eb;
  }
  .topbar-left h1 {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin-bottom: 4px;
  }
  .topbar-sub {
    color: #777;
    font-size: 13px;
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #666;
    font-size: 13px;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2e7d32;
    box-shadow: 0 0 0 4px rgba(46,125,50,0.15);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }
  .btn-refresh {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #e0e0e5;
    font-size: 15px;
    transition: background 0.15s, transform 0.2s;
    cursor: pointer;
  }
