  .ri-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f2f2f5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }
  .ri-body {
    flex: 1;
    min-width: 0;
  }
  .ri-title {
    font-size: 13px;
    font-weight: 600;
    color: #111;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ri-sub {
    font-size: 11px;
    color: #888;
