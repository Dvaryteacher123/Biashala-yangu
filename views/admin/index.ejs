  .bar:hover {
    background: linear-gradient(180deg, #e63946 0%, #c53030 100%);
  }
  .bar-value {
    font-size: 11px;
    font-weight: 700;
    color: #111;
    white-space: nowrap;
  }
  .bar-label {
    font-size: 11px;
    color: #888;
    text-transform: uppercase;
  }
  .chart-legend {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #888;
    font-size: 12px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #f0f0f3;
