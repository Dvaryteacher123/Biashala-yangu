  }

  @media (max-width: 900px) {
    .admin-main {
      margin-left: 0;
      width: 100%;
      padding: 70px 16px 40px;
    }
  }
  @media (max-width: 600px) {
    .stat-num { font-size: 20px; }
    .stat-icon { width: 44px; height: 44px; font-size: 18px; }
    .chart { height: 160px; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA DASHBOARD — Firestore halisi
     ========================================================== -->
<script type="module">

  const fmt = (n) => `TSh ${Number(n || 0).toLocaleString()}`;

  // ==========================================================
  // 1. Pakia takwimu zote
  // ==========================================================
  async function loadDashboard() {
    const loading = document.getElementById('dashLoading');
    const content = document.getElementById('dashContent');

    if (loading) loading.style.display = 'flex';
    if (content) content.style.display = 'none';

    try {
      const { collection, getDocs } = window.fs;

      const [productsSnap, ordersSnap, customersSnap, messagesSnap] = await Promise.all([
        getDocs(collection(window.db, 'products')),
        getDocs(collection(window.db, 'orders')),
        getDocs(collection(window.db, 'users')),
        getDocs(collection(window.db, 'messages'))
      ]);

      const products  = productsSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
      const orders    = ordersSnap.docs.map((d) => ({ id: d.id, ...d.data() }));
      const customers = customersSnap.docs.map((d) => ({ id: d.id, ...d.data() }))
        .filter((u) => !u.role || u.role === 'customer');
      const messages  = messagesSnap.docs.map((d) => ({ id: d.id, ...d.data() }));

      renderStats(products, orders, customers);
      renderChart(orders);
      renderRecentOrders(orders);
      renderLowStock(products);
      renderRecentMessages(messages);

      const lastUpdateEl = document.getElementById('lastUpdate');
      if (lastUpdateEl) {
        lastUpdateEl.textContent =
          'Imesasishwa: ' + new Date().toLocaleTimeString('sw-TZ', { hour: '2-digit', minute: '2-digit' });
      }

      if (loading) loading.style.display = 'none';
      if (content) content.style.display = 'block';

    } catch (err) {
      console.error('Dashboard error:', err);
      if (loading) loading.style.display = 'none';
      if (content) content.style.display = 'block';
    }
  }

  // ==========================================================
  // 2. Stats
  // ==========================================================
  function renderStats(products, orders, customers) {
    document.getElementById('statProducts').textContent = products.length;
    const lowStockCount = products.filter((p) => Number(p.stock || 0) < 5).length;
    document.getElementById('statProductsSub').textContent =
      lowStockCount > 0 ? `${lowStockCount} zinaisha stokini` : 'Stoko ipo vizuri';

    document.getElementById('statOrders').textContent = orders.length;
    const pendingCount = orders.filter((o) => (o.status || 'pending') === 'pending').length;
    document.getElementById('statOrdersSub').textContent =
      pendingCount > 0 ? `${pendingCount} zinasubiri` : 'Zote zimeshughulikiwa';

    const revenue = orders
      .filter((o) => (o.status || '') !== 'cancelled')
      .reduce((s, o) => s + Number(o.total || 0), 0);
    document.getElementById('statRevenue').textContent = fmt(revenue);

    const week = Date.now() - 7 * 24 * 60 * 60 * 1000;
    const weekRevenue = orders
      .filter((o) => {
        const t = o.createdAt?.seconds ? o.createdAt.seconds * 1000 : 0;
        return t >= week && o.status !== 'cancelled';
      })
      .reduce((s, o) => s + Number(o.total || 0), 0);
    document.getElementById('statRevenueSub').textContent =
      `Siku 7: ${fmt(weekRevenue)}`;

    document.getElementById('statCustomers').textContent = customers.length;
    const weekCustomers = customers.filter((u) => {
      const t = u.createdAt?.seconds ? u.createdAt.seconds * 1000 : 0;
      return t >= week;
    }).length;
    document.getElementById('statCustomersSub').textContent =
      weekCustomers > 0 ? `+${weekCustomers} wiki hii` : 'Hakuna mpya wiki hii';
  }

  // ==========================================================
  // 3. Chart (siku 7 zilizopita)
  // ==========================================================
  function renderChart(orders) {
    const days = [];
    const labels = ['Alh', 'Ith', 'Jum', 'Ara', 'Hams', 'Ij', 'Jum'];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setHours(0, 0, 0, 0);
      d.setDate(d.getDate() - i);
      days.push({
        date: d,
        label: labels[d.getDay()],
        total: 0
      });
    }

    orders.forEach((o) => {
      if (o.status === 'cancelled') return;
      const t = o.createdAt?.seconds ? o.createdAt.seconds * 1000 : 0;
      if (!t) return;
      const day = days.find((d) => {
        const next = new Date(d.date);
        next.setDate(next.getDate() + 1);
        return t >= d.date.getTime() && t < next.getTime();
      });
      if (day) day.total += Number(o.total || 0);
    });

    const max = Math.max(...days.map((d) => d.total), 1);

    const html = days.map((d) => {
      const heightPct = (d.total / max) * 100;
      const valLabel = d.total > 0
        ? (d.total >= 1000 ? `${Math.round(d.total / 1000)}k` : d.total)
        : '';
      return `
        <div class="bar-wrap" title="${d.date.toLocaleDateString('sw-TZ')} — ${fmt(d.total)}">
          ${valLabel ? `<div class="bar-value">${valLabel}</div>` : '<div class="bar-value">&nbsp;</div>'}
          <div class="bar" style="height: ${Math.max(heightPct, 2)}%;"></div>
          <div class="bar-label">${d.label}</div>
        </div>
      `;
    }).join('');

    const chartEl = document.getElementById('salesChart');
    if (chartEl) chartEl.innerHTML = html;
  }

  // ==========================================================
  // 4. Recent Orders
  // ==========================================================
  function renderRecentOrders(orders) {
    const el = document.getElementById('recentOrders');
    if (!el) return;

    const sorted = orders.slice().sort((a, b) => {
      const ta = a.createdAt?.seconds || 0;
      const tb = b.createdAt?.seconds || 0;
      return tb - ta;
    }).slice(0, 5);

    if (sorted.length === 0) {
      el.innerHTML = '<p class="muted">Hakuna oda bado</p>';
      return;
    }

    el.innerHTML = sorted.map((o) => {
      const status = (o.status || 'pending').toLowerCase();
      const name = o.customer?.name || o.userEmail || 'Mteja';
      const date = o.createdAt?.seconds
        ? new Date(o.createdAt.seconds * 1000).toLocaleDateString('sw-TZ')
        : '';
      return `
        <a href="/admin/orders/${o.id}" class="recent-item">
          <div class="ri-icon">🧾</div>
          <div class="ri-body">
            <div class="ri-title">${escapeHtml(o.orderNumber || o.id)}</div>
            <div class="ri-sub">${escapeHtml(name)} • ${date}</div>
          </div>
          <div class="ri-right">
            <div class="ri-amount">${fmt(o.total)}</div>
            <span class="ri-badge ${status}">${status}</span>
          </div>
        </a>
      `;
    }).join('');
  }

  // ==========================================================
  // 5. Low stock
  // ==========================================================
  function renderLowStock(products) {
    const el = document.getElementById('lowStockList');
    if (!el) return;

    const low = products
      .filter((p) => Number(p.stock || 0) < 5)
      .sort((a, b) => (Number(a.stock) || 0) - (Number(b.stock) || 0))
      .slice(0, 6);

    if (low.length === 0) {
      el.innerHTML = '<p class="muted">Stoko ipo vizuri — hakuna bidhaa inayoisha</p>';
      return;
    }

    el.innerHTML = low.map((p) => `
      <a href="/admin/products/edit/${p.id}" class="recent-item">
        <div class="ri-icon">👕</div>
        <div class="ri-body">
          <div class="ri-title">${escapeHtml(p.name || 'Bidhaa')}</div>
          <div class="ri-sub">${fmt(p.price)}</div>
        </div>
        <div class="ri-right">
          <div class="ri-stock-warn">${Number(p.stock || 0)}</div>
          <div class="ri-stock-ok">imebaki</div>
        </div>
      </a>
    `).join('');
  }

  // ==========================================================
  // 6. Recent Messages
  // ==========================================================
  function renderRecentMessages(messages) {
    const el = document.getElementById('recentMessages');
    if (!el) return;

    const sorted = messages.slice().sort((a, b) => {
      const ta = a.createdAt?.seconds || 0;
      const tb = b.createdAt?.seconds || 0;
      return tb - ta;
    }).slice(0, 5);

    if (sorted.length === 0) {
      el.innerHTML = '<p class="muted">Hakuna ujumbe bado</p>';
      return;
    }

    el.innerHTML = sorted.map((m) => {
      const date = m.createdAt?.seconds
        ? new Date(m.createdAt.seconds * 1000).toLocaleDateString('sw-TZ')
        : '';
      const isNew = (m.status || 'new') === 'new';
      return `
        <a href="/admin/messages" class="recent-item">
          <div class="ri-icon">${isNew ? '📩' : '📧'}</div>
          <div class="ri-body">
            <div class="ri-title">${escapeHtml(m.name || 'Mgeni')}</div>
            <div class="ri-sub">${escapeHtml((m.message || '').slice(0, 50))}...</div>
          </div>
          <div class="ri-right">
            ${isNew ? '<span class="ri-badge pending">Mpya</span>' : ''}
            <div class="ri-stock-ok" style="margin-top:4px;">${date}</div>
          </div>
        </a>
      `;
    }).join('');
  }

  // ==========================================================
  // Helpers
  // ==========================================================
  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // ==========================================================
  // Boot (Imerekebishwa kuondoa mkwamo)
  // ==========================================================
  function boot() {
    const refreshBtn = document.getElementById('refreshBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', loadDashboard);
    }
    loadDashboard();
  }

  document.addEventListener('DOMContentLoaded', boot);
</script>

