<%- include('../partials/header', { title, description }) %>

<!-- ==========================================================
     ADMIN CATEGORIES — Full Width Layout
     Firestore: categories collection
     ========================================================== -->

<%- include('../partials/admin-sidebar') %>

<main class="admin-main">

  <!-- Topbar -->
  <div class="admin-topbar">
    <div class="topbar-left">
      <h1>📂 Makundi ya Bidhaa</h1>
      <p class="topbar-sub">Simamia makundi yote ya bidhaa za duka</p>
    </div>
    <div class="topbar-right">
      <button class="btn btn-primary" id="addCatBtn">➕ Ongeza Kundi</button>
    </div>
  </div>

  <!-- Loading -->
  <div id="catLoading" class="loading">
    <div class="spinner"></div> Inapakia makundi...
  </div>

  <!-- Content -->
  <div id="catContent" style="display:none;">

    <!-- Search -->
    <div class="filters-bar">
      <div class="filter-search">
        <input
          type="text"
          id="searchInput"
          placeholder="🔍 Tafuta kundi kwa jina..."
          autocomplete="off"
        />
      </div>
      <div class="filter-stats">
        <span class="stat-chip">
          <strong id="statTotal">0</strong> makundi
        </span>
        <span class="stat-chip">
          <strong id="statProducts">0</strong> bidhaa
        </span>
      </div>
    </div>

    <!-- Empty -->
    <div id="catEmpty" class="empty-state" style="display:none;padding:70px 20px;background:#fff;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
      <h3>Hakuna makundi bado</h3>
      <p>Anza kuongeza kundi la kwanza.</p>
      <button class="btn btn-primary" id="addCatBtnEmpty" style="margin-top:14px;">
        ➕ Ongeza Kundi
      </button>
    </div>

    <!-- No results -->
    <div id="catNoResults" class="empty-state" style="display:none;padding:70px 20px;background:#fff;border-radius:12px;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
      <h3>Hakuna matokeo</h3>
      <p>Hakuna kundi linalolingana na utafutaji wako.</p>
    </div>

    <!-- Categories grid -->
    <div id="catGrid" class="cat-grid" style="display:none;"></div>

  </div>

</main>

<!-- ==========================================================
     MODAL — Ongeza / Badili Kundi
     ========================================================== -->
<div id="catModal" class="modal-overlay" style="display:none;">
  <div class="modal">
    <button class="modal-close" id="catModalClose" aria-label="Funga">✕</button>

    <h3 id="modalTitle">Ongeza Kundi Jipya</h3>

    <form id="catForm" class="modal-form" novalidate>

      <div class="field">
        <label for="cName">Jina la Kundi *</label>
        <input type="text" id="cName" placeholder="Mfano: Nguo za Wanaume" required />
        <small class="field-hint">Jina fupi linaloeleweka.</small>
      </div>

      <div class="field">
        <label for="cDesc">Maelezo (hiari)</label>
        <textarea id="cDesc" rows="2" placeholder="Maelezo mafupi kuhusu kundi hili..."></textarea>
      </div>

      <div class="field">
        <label for="cIcon">Emoji (hiari)</label>
        <input type="text" id="cIcon" maxlength="4" placeholder="👕" />
        <div class="emoji-suggest">
          <button type="button" class="emoji-btn" data-emoji="👕">👕</button>
          <button type="button" class="emoji-btn" data-emoji="👖">👖</button>
          <button type="button" class="emoji-btn" data-emoji="👗">👗</button>
          <button type="button" class="emoji-btn" data-emoji="👟">👟</button>
          <button type="button" class="emoji-btn" data-emoji="🧥">🧥</button>
          <button type="button" class="emoji-btn" data-emoji="👜">👜</button>
          <button type="button" class="emoji-btn" data-emoji="🧢">🧢</button>
          <button type="button" class="emoji-btn" data-emoji="🧦">🧦</button>
        </div>
      </div>

      <div class="field">
        <label for="cImage">Picha (URL, hiari)</label>
        <input type="url" id="cImage" placeholder="https://..." />
        <small class="field-hint">Kama haina picha, emoji itatumika.</small>
      </div>

      <div class="field">
        <label for="cOrder">Mpangilio (namba)</label>
        <input type="number" id="cOrder" value="0" />
        <small class="field-hint">Namba ndogo inaonekana kwanza.</small>
      </div>

      <label class="check-row">
        <input type="checkbox" id="cActive" checked />
        <div>
          <strong>Inaonekana dukani</strong>
          <small>Wateja wanaweza kuiona kwenye filter ya duka</small>
        </div>
      </label>

      <p id="catMsg" class="alert" style="display:none;"></p>

      <div class="form-actions">
        <button type="button" class="btn btn-outline" id="cancelBtn">Ghairi</button>
        <button type="submit" class="btn btn-primary" id="saveCatBtn">
          💾 Hifadhi
        </button>
      </div>

    </form>
  </div>
</div>

<!-- ==========================================================
     CSS YA ADMIN CATEGORIES
     ========================================================== -->
<style>
  body { background: #f4f5f7; }

  .admin-main {
    margin-left: 250px;
    padding: 26px 30px 50px;
    min-height: 100vh;
    width: calc(100% - 250px);
    box-sizing: border-box;
  }

  /* Topbar */
  .admin-topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid #e6e6eb;
  }
  .topbar-left h1 {
    font-size: 24px;
    font-weight: 800;
    color: #111;
    margin-bottom: 4px;
  }
  .topbar-sub { color: #777; font-size: 13px; }
  .topbar-right { display: flex; gap: 10px; }

  /* Filters bar */
  .filters-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    background: #fff;
    padding: 14px 16px;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  }
  .filter-search {
    flex: 1 1 260px;
    min-width: 200px;
  }
  .filter-search input {
    width: 100%;
    padding: 10px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: #fafafc;
    transition: border-color 0.15s, background 0.15s;
  }
  .filter-search input:focus {
    border-color: #111;
    background: #fff;
  }

  .filter-stats {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .stat-chip {
    background: #f2f2f5;
    color: #666;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 20px;
  }
  .stat-chip strong {
    color: #111;
    font-weight: 800;
  }

  /* Categories grid */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .cat-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    padding: 20px;
    transition: transform 0.15s, box-shadow 0.15s;
    border: 1.5px solid transparent;
  }
  .cat-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.06);
  }
  .cat-card.inactive {
    opacity: 0.6;
    border-style: dashed;
    border-color: #e0e0e5;
  }

  .cat-head {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-bottom: 14px;
  }
  .cat-avatar {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    background: #f2f2f5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    flex-shrink: 0;
    background-size: cover;
    background-position: center;
    color: #666;
  }
  .cat-info {
    flex: 1;
    min-width: 0;
  }
  .cat-name {
    font-size: 16px;
    font-weight: 700;
    color: #111;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cat-id {
    font-size: 11px;
    color: #999;
    font-family: 'SF Mono', Menlo, monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cat-desc {
    color: #666;
    font-size: 13px;
    line-height: 1.55;
    margin-bottom: 14px;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 40px;
  }

  .cat-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-top: 1px solid #f0f0f3;
    margin-bottom: 12px;
  }
  .cat-count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #666;
  }
  .cat-count strong {
    color: #111;
    font-weight: 800;
    font-size: 15px;
  }
  .cat-badges {
    display: flex;
    gap: 6px;
  }
  .badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge.active   { background: #e8f5e9; color: #1b5e20; }
  .badge.inactive { background: #fdecea; color: #b71c1c; }
  .badge.order    { background: #e3f2fd; color: #0d47a1; }

  .cat-actions {
    display: flex;
    gap: 8px;
  }
  .cat-actions button {
    flex: 1;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    border: none;
  }
  .btn-edit-cat {
    background: #e3f2fd;
    color: #0d47a1;
  }
  .btn-edit-cat:hover { background: #c9e4fb; }
  .btn-del-cat {
    background: #fdecea;
    color: #c62828;
  }
  .btn-del-cat:hover { background: #f9d5d2; }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    border: none;
  }
  .btn-primary { background: #111; color: #fff; }
  .btn-primary:hover:not(:disabled) { background: #333; }
  .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
  .btn-outline {
    background: #fff;
    color: #333;
    border: 1.5px solid #e0e0e5;
  }
  .btn-outline:hover { background: #f2f2f5; }

  /* Modal */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    animation: fadeIn 0.2s;
  }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .modal {
    background: #fff;
    border-radius: 14px;
    width: 100%;
    max-width: 480px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 26px 24px;
    position: relative;
    animation: slideUp 0.25s;
  }
  @keyframes slideUp {
    from { transform: translateY(24px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }
  .modal h3 {
    font-size: 18px;
    font-weight: 800;
    color: #111;
    margin-bottom: 20px;
    padding-right: 30px;
  }
  .modal-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #f2f2f5;
    color: #333;
    font-size: 15px;
    cursor: pointer;
    border: none;
  }
  .modal-close:hover { background: #e6e6ec; }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .field label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #333;
    margin-bottom: 6px;
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 11px 14px;
    border: 1.5px solid #e0e0e5;
    border-radius: 8px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    background: #fafafc;
    box-sizing: border-box;
    transition: border-color 0.15s, background 0.15s;
  }
  .field input:focus,
  .field textarea:focus {
    border-color: #111;
    background: #fff;
  }
  .field textarea { resize: vertical; }
  .field-hint {
    display: block;
    color: #888;
    font-size: 12px;
    margin-top: 5px;
  }

  .emoji-suggest {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .emoji-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: #f2f2f5;
    font-size: 18px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.15s;
  }
  .emoji-btn:hover {
    background: #e6e6ec;
    border-color: #111;
  }

  .check-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px;
    border-radius: 8px;
    background: #fafafc;
    cursor: pointer;
    transition: background 0.15s;
  }
  .check-row:hover { background: #f2f2f5; }
  .check-row input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    cursor: pointer;
    accent-color: #111;
  }
  .check-row div { flex: 1; min-width: 0; }
  .check-row strong {
    display: block;
    font-size: 13px;
    color: #111;
    margin-bottom: 2px;
  }
  .check-row small {
    display: block;
    font-size: 12px;
    color: #888;
    line-height: 1.4;
  }

  .form-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    padding-top: 6px;
  }

  .alert {
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.5;
  }
  .alert-error   { background: #fdecea; color: #b71c1c; }
  .alert-success { background: #e8f5e9; color: #1b5e20; }

  /* Empty state */
  .empty-state { text-align: center; color: #888; }
  .empty-state h3 { color: #333; margin-bottom: 6px; font-size: 16px; }

  /* Responsive */
  @media (max-width: 900px) {
    .admin-main {
      margin-left: 0;
      width: 100%;
      padding: 70px 14px 40px;
    }
  }
  @media (max-width: 600px) {
    .modal { padding: 22px 18px; }
    .form-actions { flex-direction: column-reverse; }
    .form-actions .btn { width: 100%; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA CATEGORIES — Firestore halisi
     ========================================================== -->
<script type="module">

  // State
  const state = {
    categories: [],   // [{ id, ...data }]
    productCounts: {}, // { categoryId: count }
    search: '',
    editingId: null
  };

  const modal = document.getElementById('catModal');
  const msg = document.getElementById('catMsg');

  // ==========================================================
  // Helpers
  // ==========================================================
  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
  function showMsg(text, type = 'error') {
    msg.textContent = text;
    msg.className = 'alert alert-' + (type === 'success' ? 'success' : 'error');
    msg.style.display = 'block';
  }
  function hideMsg() { msg.style.display = 'none'; }

  // ==========================================================
  // 1. Pakia categories + hesabu za bidhaa
  // ==========================================================
  async function loadData() {
    const loading = document.getElementById('catLoading');
    const content = document.getElementById('catContent');

    try {
      const { collection, getDocs, query, orderBy } = window.fs;

      // Categories
      let catSnap;
      try {
        catSnap = await getDocs(query(collection(window.db, 'categories'), orderBy('order', 'asc')));
      } catch {
        catSnap = await getDocs(collection(window.db, 'categories'));
      }

      state.categories = catSnap.docs.map((d) => ({ id: d.id, ...d.data() }));

      // Sort client-side (order asc, kisha name)
      state.categories.sort((a, b) => {
        const oa = Number(a.order ?? 999);
        const ob = Number(b.order ?? 999);
        if (oa !== ob) return oa - ob;
        return (a.name || '').localeCompare(b.name || '');
      });

      // Products kwa hesabu
      const prodSnap = await getDocs(collection(window.db, 'products'));
      const counts = {};
      prodSnap.docs.forEach((d) => {
        const cat = d.data().category;
        if (cat) counts[cat] = (counts[cat] || 0) + 1;
      });
      state.productCounts = counts;

      loading.style.display = 'none';
      content.style.display = 'block';

      // Stats
      document.getElementById('statTotal').textContent = state.categories.length;
      document.getElementById('statProducts').textContent = prodSnap.size;

      if (state.categories.length === 0) {
        document.getElementById('catEmpty').style.display = 'block';
        document.getElementById('catGrid').style.display = 'none';
        return;
      }

      renderGrid();

    } catch (err) {
      console.error('Load categories error:', err);
      loading.style.display = 'none';
      content.style.display = 'block';
      document.getElementById('catEmpty').style.display = 'block';
    }
  }

  // ==========================================================
  // 2. Render grid
  // ==========================================================
  function renderGrid() {
    const grid = document.getElementById('catGrid');
    const empty = document.getElementById('catEmpty');
    const noResults = document.getElementById('catNoResults');

    let items = state.categories.slice();
    if (state.search) {
      const s = state.search.toLowerCase();
      items = items.filter((c) =>
        (c.name || '').toLowerCase().includes(s) ||
        (c.description || '').toLowerCase().includes(s)
      );
    }

    if (items.length === 0) {
      grid.style.display = 'none';
      if (state.categories.length === 0) {
        empty.style.display = 'block';
        noResults.style.display = 'none';
      } else {
        empty.style.display = 'none';
        noResults.style.display = 'block';
      }
      return;
    }

    empty.style.display = 'none';
    noResults.style.display = 'none';
    grid.style.display = 'grid';

    grid.innerHTML = items.map((c) => {
      const count = state.productCounts[c.id] || 0;
      const isActive = c.active !== false;
      const avatarStyle = c.image
        ? `style="background-image:url('${c.image}')"`
        : '';
      const avatarContent = c.image ? '' : (c.icon || '📂');
      const desc = c.description || 'Hakuna maelezo';

      return `
        <div class="cat-card ${!isActive ? 'inactive' : ''}" data-id="${c.id}">
          <div class="cat-head">
            <div class="cat-avatar" ${avatarStyle}>${avatarContent}</div>
            <div class="cat-info">
              <div class="cat-name">${escapeHtml(c.name || 'Bila jina')}</div>
              <div class="cat-id">${escapeHtml(c.id)}</div>
            </div>
          </div>
          <p class="cat-desc">${escapeHtml(desc)}</p>
          <div class="cat-meta">
            <span class="cat-count">
              <strong>${count}</strong>
              bidhaa
            </span>
            <div class="cat-badges">
              ${c.order != null ? `<span class="badge order">#${c.order}</span>` : ''}
              ${isActive
                ? '<span class="badge active">Inaonekana</span>'
                : '<span class="badge inactive">Imefichwa</span>'}
            </div>
          </div>
          <div class="cat-actions">
            <button class="btn-edit-cat" data-edit="${c.id}">✏️ Badili</button>
            <button class="btn-del-cat" data-del="${c.id}">🗑️ Futa</button>
          </div>
        </div>
      `;
    }).join('');

    // Bind
    grid.querySelectorAll('[data-edit]').forEach((b) => {
      b.addEventListener('click', () => openEdit(b.dataset.edit));
    });
    grid.querySelectorAll('[data-del]').forEach((b) => {
      b.addEventListener('click', () => deleteCat(b.dataset.del));
    });
  }

  // ==========================================================
  // 3. Modal open / close
  // ==========================================================
  function openAdd() {
    state.editingId = null;
    document.getElementById('modalTitle').textContent = 'Ongeza Kundi Jipya';
    document.getElementById('catForm').reset();
    document.getElementById('cOrder').value = '0';
    document.getElementById('cActive').checked = true;
    hideMsg();
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('cName').focus(), 100);
  }

  function openEdit(id) {
    const c = state.categories.find((x) => x.id === id);
    if (!c) return;

    state.editingId = id;
    document.getElementById('modalTitle').textContent = 'Badili Kundi';

    document.getElementById('cName').value  = c.name || '';
    document.getElementById('cDesc').value  = c.description || '';
    document.getElementById('cIcon').value  = c.icon || '';
    document.getElementById('cImage').value = c.image || '';
    document.getElementById('cOrder').value = c.order ?? 0;
    document.getElementById('cActive').checked = c.active !== false;

    hideMsg();
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    setTimeout(() => document.getElementById('cName').focus(), 100);
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    state.editingId = null;
  }

  // ==========================================================
  // 4. Submit (save)
  // ==========================================================
  function bindForm() {
    document.getElementById('catForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      hideMsg();

      const name  = document.getElementById('cName').value.trim();
      const desc  = document.getElementById('cDesc').value.trim();
      const icon  = document.getElementById('cIcon').value.trim();
      const image = document.getElementById('cImage').value.trim();
      const order = Number(document.getElementById('cOrder').value || 0);
      const active = document.getElementById('cActive').checked;

      if (!name || name.length < 2) {
        showMsg('Jina la kundi liwe herufi 2+.'); return;
      }
      if (image && !/^https?:\/\//i.test(image)) {
        showMsg('Picha URL lazima ianze na https://'); return;
      }

      const saveBtn = document.getElementById('saveCatBtn');
      saveBtn.disabled = true;
      const orig = saveBtn.textContent;
      saveBtn.textContent = 'Inahifadhi...';

      try {
        const { collection, doc, addDoc, setDoc, serverTimestamp } = window.fs;

        const payload = {
          name,
          description: desc,
          icon,
          image,
          order,
          active,
          updatedAt: serverTimestamp()
        };

        if (state.editingId) {
          await setDoc(
            doc(window.db, 'categories', state.editingId),
            payload,
            { merge: true }
          );
        } else {
          payload.createdAt = serverTimestamp();
          await addDoc(collection(window.db, 'categories'), payload);
        }

        closeModal();
        await loadData();

      } catch (err) {
        console.error('Save category error:', err);
        showMsg('Imeshindikana kuhifadhi. Jaribu tena.');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = orig;
      }
    });
  }

  // ==========================================================
  // 5. Futa kundi
  // ==========================================================
  async function deleteCat(id) {
    const c = state.categories.find((x) => x.id === id);
    const name = c?.name || id;
    const count = state.productCounts[id] || 0;

    let confirmText = `Una uhakika unataka kufuta kundi "${name}"?`;
    if (count > 0) {
      confirmText += `\n\nKuna bidhaa ${count} kwenye kundi hili. Bidhaa hazitafutwa, lakini zitakuwa bila kundi.`;
    }

    if (!confirm(confirmText)) return;

    try {
      const { doc, deleteDoc } = window.fs;
      await deleteDoc(doc(window.db, 'categories', id));
      await loadData();
    } catch (err) {
      console.error('Delete category error:', err);
      alert('Imeshindikana kufuta. Jaribu tena.');
    }
  }

  // ==========================================================
  // 6. Search
  // ==========================================================
  function bindSearch() {
    let timer;
    document.getElementById('searchInput').addEventListener('input', (e) => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        state.search = e.target.value.trim();
        renderGrid();
      }, 200);
    });
  }

  // ==========================================================
  // 7. Emoji picker
  // ==========================================================
  function bindEmoji() {
    document.querySelectorAll('.emoji-btn').forEach((b) => {
      b.addEventListener('click', () => {
        document.getElementById('cIcon').value = b.dataset.emoji;
      });
    });
  }

  // ==========================================================
  // 8. Modal events
  // ==========================================================
  function bindModalEvents() {
    document.getElementById('addCatBtn').addEventListener('click', openAdd);
    document.getElementById('addCatBtnEmpty').addEventListener('click', openAdd);
    document.getElementById('catModalClose').addEventListener('click', closeModal);
    document.getElementById('cancelBtn').addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target.id === 'catModal') closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.style.display === 'flex') closeModal();
    });
  }

  // ==========================================================
  // 9. Boot
  // ==========================================================
  function boot() {
    bindSearch();
    bindModalEvents();
    bindForm();
    bindEmoji();

    const checkReady = setInterval(() => {
      const sidebar = document.getElementById('adminSidebar');
      if (sidebar && sidebar.style.visibility !== 'hidden') {
        clearInterval(checkReady);
        loadData();
      }
    }, 200);
    setTimeout(() => {
      clearInterval(checkReady);
      if (document.getElementById('catContent').style.display === 'none') {
        loadData();
      }
    }, 2000);
  }

  boot();
</script>
