    margin-bottom: 14px;
  }
  .prose li { margin-bottom: 6px; }

  /* ---------- Timeline table ---------- */
  .timeline-table-wrap {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    overflow: hidden;
  }
  .timeline-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .timeline-table thead {
    background: #f7f7f9;
  }
  .timeline-table th {
    text-align: left;
    padding: 14px 18px;
    font-size: 12px;
    font-weight: 700;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #eee;
  }
  .timeline-table td {
    padding: 14px 18px;
    color: #333;
    border-bottom: 1px solid #f4f4f6;
  }
  .timeline-table tbody tr:last-child td { border-bottom: none; }
  .timeline-table tbody tr:hover { background: #fafafc; }
  .timeline-table td:nth-child(2) {
    font-weight: 700;
    color: #e63946;
  }
  .timeline-note {
    font-size: 13px;
    color: #888;
    margin-top: 10px;
    line-height: 1.5;
  }

  /* ---------- CTA ---------- */
  .rt-cta {
    margin: 50px 0 0;
    background: linear-gradient(135deg, #e63946 0%, #c53030 100%);
    color: #fff;
    border-radius: 14px;
    padding: 34px 24px;
    text-align: center;
  }
  .rt-cta h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .rt-cta p {
    color: #ffe5e7;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .rt-cta .btn-primary {
    background: #fff;
    color: #e63946;
  }
  .rt-cta .btn-primary:hover {
    background: #ffe5e7;
    color: #111;
  }
  .rt-cta .btn-outline {
    border-color: #fff;
    color: #fff;
  }
  .rt-cta .btn-outline:hover {
    background: #fff;
    color: #e63946;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 600px) {
    .rt-hero h1 { font-size: 24px; }
    .timeline-table th,
    .timeline-table td { padding: 12px 12px; font-size: 13px; }
    .step-item { padding: 16px; }
    .cond-list li,
    .excep-list li { padding: 12px 16px; font-size: 13px; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA RETURNS — Firestore: pages/returns
     Document structure inayotarajiwa:
       title, intro,
       highlights: [{ icon, title, text }],
       conditions: ["...", "..."],
       steps: [{ title, text }],
       exceptions: ["...", "..."],
       body: "paragraph 1\n\n## Heading\n\n- Bullet 1",
       timeline: [{ type, time, status }],
       timelineNote
     Kila kitu ni hiari.
     ========================================================== -->
<script type="module">

  async function loadReturns() {
    const loading = document.getElementById('rtLoading');
    const empty   = document.getElementById('rtEmpty');
    const content = document.getElementById('rtContent');

    try {
      const { doc, getDoc } = window.fs;
      const snap = await getDoc(doc(window.db, 'pages', 'returns'));

      loading.style.display = 'none';

      if (!snap.exists()) {
        empty.style.display = 'block';
        return;
      }

      render(snap.data());
      content.style.display = 'block';

    } catch (err) {
      console.error('Returns error:', err);
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  function render(data) {
    // Title + intro
    if (data.title) document.getElementById('rtTitle').textContent = data.title;
    if (data.intro) document.getElementById('rtIntro').textContent = data.intro;
    else document.getElementById('rtIntro').style.display = 'none';

    // Highlights
    if (Array.isArray(data.highlights) && data.highlights.length) {
      document.getElementById('hlSection').style.display = 'block';
      document.getElementById('hlGrid').innerHTML = data.highlights.map((h) => `
        <div class="highlight-card">
          ${h.icon ? `<div class="hl-icon">${escapeHtml(h.icon)}</div>` : ''}
          <div class="hl-title">${escapeHtml(h.title || '')}</div>
          <div class="hl-text">${escapeHtml(h.text || '')}</div>
        </div>
      `).join('');
    }

    // Conditions
    if (Array.isArray(data.conditions) && data.conditions.length) {
      document.getElementById('condSection').style.display = 'block';
      document.getElementById('condList').innerHTML = data.conditions
        .map((c) => `<li>${escapeHtml(c)}</li>`).join('');
    }

    // Steps
    if (Array.isArray(data.steps) && data.steps.length) {
      document.getElementById('stepsSection').style.display = 'block';
      document.getElementById('stepsList').innerHTML = data.steps.map((s, i) => `
        <div class="step-item">
          <div class="step-num">${i + 1}</div>
          <div class="step-body">
            <div class="step-title">${escapeHtml(s.title || '')}</div>
            <div class="step-text">${escapeHtml(s.text || '')}</div>
          </div>
        </div>
      `).join('');
    }

    // Exceptions
    if (Array.isArray(data.exceptions) && data.exceptions.length) {
      document.getElementById('excepSection').style.display = 'block';
      document.getElementById('excepList').innerHTML = data.exceptions
        .map((e) => `<li>${escapeHtml(e)}</li>`).join('');
    }

    // Body
    if (data.body) {
      document.getElementById('bodySection').style.display = 'block';
      document.getElementById('bodyText').innerHTML = parseBody(data.body);
    }

    // Timeline table
    if (Array.isArray(data.timeline) && data.timeline.length) {
      document.getElementById('timelineSection').style.display = 'block';
      document.getElementById('timelineBody').innerHTML = data.timeline.map((t) => `
        <tr>
          <td>${escapeHtml(t.type || '')}</td>
          <td>${escapeHtml(t.time || '')}</td>
          <td>${escapeHtml(t.status || '')}</td>
        </tr>
      `).join('');

      if (data.timelineNote) {
        document.getElementById('timelineNote').style.display = 'block';
        document.getElementById('timelineNote').textContent = data.timelineNote;
      }
    }
  }

  // Markdown ndogo: ## Heading, "- item" bullet, newlines
  function parseBody(body) {
    return body.split('\n\n').map((p) => {
      const t = p.trim();
      if (!t) return '';
      if (t.startsWith('## ')) {
        return `<h3>${escapeHtml(t.slice(3))}</h3>`;
      }
      const lines = t.split('\n');
      if (lines.every((l) => l.trim().startsWith('- '))) {
        return `<ul>${lines.map((l) => `<li>${escapeHtml(l.trim().slice(2))}</li>`).join('')}</ul>`;
      }
      return `<p>${escapeHtml(t).replace(/\n/g, '<br>')}</p>`;
    }).join('');
  }

  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function boot() { loadReturns(); }

  if (window.fs && window.db) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
