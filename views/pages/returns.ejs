<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     RETURNS PAGE — Firestore: pages/returns
     ========================================================== -->

<main class="returns-page">

  <!-- ============ Hero ============ -->
  <section class="rt-hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-badge">🔄 Kurudisha</span>
        <h1 id="rtTitle">Sera ya Kurudisha Bidhaa</h1>
        <p id="rtIntro" class="hero-sub">Inapakia...</p>
      </div>
    </div>
  </section>

  <!-- ============ Loading ============ -->
  <div id="rtLoading" class="container" style="padding:40px 0;">
    <div class="loading">
      <div class="spinner"></div> Inapakia maudhui...
    </div>
  </div>

  <!-- ============ Empty ============ -->
  <div id="rtEmpty" class="container" style="display:none;padding:40px 0;">
    <div class="empty-state">
      <h3>Maudhui yataonekana hapa</h3>
      <p>
        Sera ya kurudisha bado haijawekwa. Msimamizi anaweza kuiweka kupitia
        Firestore collection <code>pages/returns</code>.
      </p>
      <a href="/contact" class="btn btn-primary" style="margin-top:14px;">Wasiliana Nasi</a>
    </div>
  </div>

  <!-- ============ Content ============ -->
  <div id="rtContent" style="display:none;">
    <div class="container narrow">

      <!-- Highlights -->
      <section class="highlights" id="hlSection" style="display:none;">
        <div class="highlights-grid" id="hlGrid"></div>
      </section>

      <!-- Conditions (vinginevyo hairudishwi) -->
      <section class="cond-section" id="condSection" style="display:none;">
        <h2>✅ Masharti ya Kurudisha</h2>
        <ul class="cond-list" id="condList"></ul>
      </section>

      <!-- Steps -->
      <section class="steps-section" id="stepsSection" style="display:none;">
        <h2>🛠️ Jinsi ya Kurudisha</h2>
        <div class="steps-list" id="stepsList"></div>
      </section>

      <!-- Exceptions (bidhaa zisizorudishwa) -->
      <section class="excep-section" id="excepSection" style="display:none;">
        <h2>🚫 Bidhaa Zisizorudishwa</h2>
        <ul class="excep-list" id="excepList"></ul>
      </section>

      <!-- Body / long text -->
      <section class="body-section" id="bodySection" style="display:none;">
        <div class="prose" id="bodyText"></div>
      </section>

      <!-- Timeline ya muda -->
      <section class="timeline-section" id="timelineSection" style="display:none;">
        <h2>⏱️ Muda wa Kurudisha</h2>
        <div class="timeline-table-wrap">
          <table class="timeline-table">
            <thead>
              <tr>
                <th>Aina ya Bidhaa</th>
                <th>Muda</th>
                <th>Hali</th>
              </tr>
            </thead>
            <tbody id="timelineBody"></tbody>
          </table>
        </div>
        <p class="timeline-note" id="timelineNote" style="display:none;"></p>
      </section>

      <!-- Contact CTA -->
      <section class="rt-cta">
        <h3>Unataka kurudisha bidhaa?</h3>
        <p>Wasiliana nasi na tutakusaidia kuanza mchakato wa kurudisha.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Anza Kurudisha</a>
          <a href="/account/orders" class="btn btn-outline">Oda Zangu</a>
        </div>
      </section>

    </div>
  </div>

</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA RETURNS PAGE
     ========================================================== -->
<style>
  .returns-page { padding-bottom: 40px; }

  /* ---------- Hero ---------- */
  .rt-hero {
    background: linear-gradient(135deg, #111 0%, #2a2a2a 100%);
    color: #fff;
    padding: 55px 0;
    text-align: center;
  }
  .hero-inner { max-width: 700px; margin: 0 auto; }
  .hero-badge {
    display: inline-block;
    background: #e63946;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .rt-hero h1 {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .hero-sub {
    color: #ccc;
    font-size: 16px;
    line-height: 1.6;
  }

  .container.narrow { max-width: 860px; }

  /* ---------- Highlights ---------- */
  .highlights { padding: 30px 0 10px; }
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .highlight-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 20px;
    text-align: center;
  }
  .hl-icon {
    font-size: 28px;
    margin-bottom: 8px;
  }
  .hl-title {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }
  .hl-text {
    font-size: 13px;
    color: #666;
    line-height: 1.5;
  }

  /* ---------- Sections base ---------- */
  .cond-section,
  .steps-section,
  .excep-section,
  .body-section,
  .timeline-section {
    padding: 30px 0 10px;
  }
  .cond-section h2,
  .steps-section h2,
  .excep-section h2,
  .timeline-section h2 {
    font-size: 22px;
    font-weight: 800;
    color: #111;
    margin-bottom: 16px;
  }

  /* ---------- Conditions list ---------- */
  .cond-list {
    list-style: none;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 6px 0;
  }
  .cond-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 20px;
    border-bottom: 1px solid #f4f4f6;
    font-size: 14px;
    color: #444;
    line-height: 1.6;
  }
  .cond-list li:last-child { border-bottom: none; }
  .cond-list li::before {
    content: '✓';
    color: #2e7d32;
    background: #e8f5e9;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ---------- Exceptions list ---------- */
  .excep-list {
    list-style: none;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 6px 0;
  }
  .excep-list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 20px;
    border-bottom: 1px solid #f4f4f6;
    font-size: 14px;
    color: #444;
    line-height: 1.6;
  }
  .excep-list li:last-child { border-bottom: none; }
  .excep-list li::before {
    content: '✕';
    color: #c62828;
    background: #fdecea;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* ---------- Steps ---------- */
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .step-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 18px 20px;
  }
  .step-num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    flex-shrink: 0;
  }
  .step-body { flex: 1; min-width: 0; }
  .step-title {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }
  .step-text {
    font-size: 14px;
    color: #555;
    line-height: 1.6;
  }

  /* ---------- Body prose ---------- */
  .prose {
    color: #444;
    font-size: 15px;
    line-height: 1.8;
  }
  .prose p { margin-bottom: 14px; }
  .prose h3 {
    font-size: 18px;
    font-weight: 800;
    color: #111;
    margin: 22px 0 10px;
  }
  .prose ul,
  .prose ol {
