<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     FAQ PAGE — Firestore: faqs collection
     ========================================================== -->

<main class="faq-page">

  <!-- ============ Hero ============ -->
  <section class="faq-hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-badge">❓ Maswali</span>
        <h1>Maswali Yanayoulizwa Mara kwa Mara</h1>
        <p class="hero-sub">
          Pata majibu ya haraka kwa maswali yanayoulizwa sana. Kama hujapata jibu,
          <a href="/contact" class="hero-link">wasiliana nasi</a>.
        </p>
      </div>

      <!-- Search -->
      <div class="faq-search">
        <input
          type="text"
          id="faqSearch"
          placeholder="🔍 Tafuta swali... (mfano: usafirishaji, malipo)"
          autocomplete="off"
        />
      </div>
    </div>
  </section>

  <!-- ============ Body ============ -->
  <section class="faq-body">
    <div class="container">

      <!-- Loading -->
      <div id="faqLoading" class="loading">
        <div class="spinner"></div> Inapakia maswali...
      </div>

      <!-- Empty -->
      <div id="faqEmpty" class="empty-state" style="display:none;">
        <h3>Hakuna maswali bado</h3>
        <p>Maswali yataonekana hapa yakiongezwa. Kwa sasa unaweza kuwasiliana nasi moja kwa moja.</p>
        <a href="/contact" class="btn btn-primary" style="margin-top:14px;">Wasiliana Nasi</a>
      </div>

      <!-- Content -->
      <div id="faqContent" style="display:none;">

        <!-- Tabs -->
        <div class="faq-tabs" id="faqTabs"></div>

        <!-- No results -->
        <div id="faqNoResults" class="no-results" style="display:none;">
          <p>Hakuna swali linalolingana na utafutaji wako.</p>
        </div>

        <!-- Accordion -->
        <div class="faq-list" id="faqList"></div>

      </div>

      <!-- CTA -->
      <div class="faq-cta">
        <h3>Hukupata jibu unalolitafuta?</h3>
        <p>Tuma swali lako kwetu na tutakujibu haraka.</p>
        <a href="/contact" class="btn btn-primary">Wasiliana Nasi</a>
      </div>

    </div>
  </section>

</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA FAQ PAGE
     ========================================================== -->
<style>
  .faq-page { padding-bottom: 40px; }

  /* ---------- Hero ---------- */
  .faq-hero {
    background: linear-gradient(135deg, #111 0%, #2a2a2a 100%);
    color: #fff;
    padding: 55px 0 45px;
    text-align: center;
  }
  .hero-inner { max-width: 720px; margin: 0 auto; }
  .hero-badge {
    display: inline-block;
    background: #e63946;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .faq-hero h1 {
    font-size: 34px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .hero-sub {
    color: #ccc;
    font-size: 16px;
    line-height: 1.6;
  }
  .hero-link {
    color: #e63946;
    font-weight: 700;
    text-decoration: underline;
  }

  /* Search */
  .faq-search {
    max-width: 560px;
    margin: 26px auto 0;
  }
  .faq-search input {
    width: 100%;
    padding: 14px 20px;
    border-radius: 30px;
    border: none;
    outline: none;
    font-size: 15px;
    font-family: inherit;
    background: #fff;
    color: #111;
    box-shadow: 0 6px 24px rgba(0,0,0,0.15);
  }

  /* ---------- Body ---------- */
  .faq-body { padding: 40px 0; }

  /* ---------- Tabs ---------- */
  .faq-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 26px;
  }
  .faq-tab {
    padding: 9px 16px;
    border-radius: 20px;
    background: #fff;
    border: 1.5px solid #e0e0e5;
    font-size: 13px;
    font-weight: 600;
    color: #555;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.15s;
  }
  .faq-tab:hover { border-color: #999; color: #111; }
  .faq-tab.active {
    background: #111;
    color: #fff;
    border-color: #111;
  }
  .faq-tab .tab-count {
    display: inline-block;
    background: rgba(0,0,0,0.08);
    padding: 1px 7px;
    border-radius: 10px;
    font-size: 11px;
    margin-left: 4px;
  }
  .faq-tab.active .tab-count {
    background: rgba(255,255,255,0.2);
  }

  /* ---------- Accordion ---------- */
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    overflow: hidden;
    transition: box-shadow 0.15s;
  }
  .faq-item.open {
    box-shadow: 0 4px 16px rgba(0,0,0,0.08);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 22px;
    background: transparent;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    color: #111;
    transition: background 0.15s;
  }
  .faq-question:hover { background: #fafafc; }

  .faq-q-text {
    flex: 1;
    line-height: 1.45;
  }

  .faq-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #f2f2f5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: #333;
    flex-shrink: 0;
    transition: transform 0.25s, background 0.15s;
  }
  .faq-item.open .faq-icon {
    background: #111;
    color: #fff;
    transform: rotate(45deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .faq-answer-inner {
    padding: 0 22px 20px;
    color: #555;
    font-size: 14px;
    line-height: 1.75;
    white-space: pre-line;
    border-top: 1px solid #f0f0f3;
    padding-top: 16px;
    margin-top: 0;
  }

  /* Category badge kwenye swali */
  .faq-cat-badge {
    display: inline-block;
    background: #f2f2f5;
    color: #666;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 8px;
    border-radius: 10px;
    margin-left: 8px;
    vertical-align: middle;
  }

  /* ---------- No results ---------- */
  .no-results {
    text-align: center;
    padding: 40px 20px;
    color: #888;
    font-size: 14px;
  }

  /* ---------- CTA ---------- */
  .faq-cta {
    max-width: 820px;
    margin: 50px auto 0;
    background: linear-gradient(135deg, #e63946 0%, #c53030 100%);
    color: #fff;
    border-radius: 14px;
    padding: 34px 24px;
    text-align: center;
  }
  .faq-cta h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .faq-cta p {
    color: #ffe5e7;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .faq-cta .btn-primary {
    background: #fff;
    color: #e63946;
  }
  .faq-cta .btn-primary:hover {
    background: #ffe5e7;
    color: #111;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 600px) {
    .faq-hero h1 { font-size: 24px; }
    .faq-question { padding: 16px 18px; font-size: 14px; }
    .faq-answer-inner { padding: 0 18px 18px; }
    .faq-cat-badge { display: none; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA FAQ — Firestore: faqs collection
     ========================================================== -->
<script type="module">

  // Category labels (kwa tabs)
  const CATEGORY_LABELS = {
    general:    'Jumla',
    orders:     'Oda',
    shipping:   'Usafirishaji',
    returns:    'Kurudisha',
    payment:    'Malipo',
    products:   'Bidhaa'
  };

  // State
  const state = {
    faqs: [],
    filter: 'all',
    search: ''
  };

  // ==========================================================
  // 1. Pakia faqs kutoka Firestore
  //    Document structure:
  //      { question, answer, category, order }
  //    category: general | orders | shipping | returns | payment | products
  //    order: namba (kupanga)
  // ==========================================================
  async function loadFaqs() {
    const loading = document.getElementById('faqLoading');
    const empty   = document.getElementById('faqEmpty');
    const content = document.getElementById('faqContent');

    try {
      const { collection, getDocs, query, orderBy } = window.fs;

      let snap;
      try {
        snap = await getDocs(query(collection(window.db, 'faqs'), orderBy('order', 'asc')));
      } catch {
        // fallback kama order field haipo
        snap = await getDocs(collection(window.db, 'faqs'));
      }

      loading.style.display = 'none';

      if (snap.empty) {
        empty.style.display = 'block';
        return;
      }

      state.faqs = snap.docs.map((d) => ({ id: d.id, ...d.data() }));

      // Sort client-side kama fallback
      state.faqs.sort((a, b) => {
        const oa = Number(a.order ?? 999);
        const ob = Number(b.order ?? 999);
        if (oa !== ob) return oa - ob;
        return (a.question || '').localeCompare(b.question || '');
      });

      content.style.display = 'block';
      renderTabs();
      renderFaqs();

    } catch (err) {
      console.error('FAQ error:', err);
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  // ==========================================================
  // 2. Tabs (categories)
  // ==========================================================
  function renderTabs() {
    const counts = { all: state.faqs.length };
    state.faqs.forEach((f) => {
      const c = f.category || 'general';
      counts[c] = (counts[c] || 0) + 1;
    });

    const tabsEl = document.getElementById('faqTabs');
    const tabs = [['all', 'Zote']];
    Object.keys(CATEGORY_LABELS).forEach((key) => {
      if (counts[key]) tabs.push([key, CATEGORY_LABELS[key]]);
    });

    tabsEl.innerHTML = tabs.map(([key, label]) => `
      <button class="faq-tab ${state.filter === key ? 'active' : ''}" data-filter="${key}">
        ${label}
        <span class="tab-count">${counts[key] || 0}</span>
      </button>
    `).join('');

    tabsEl.querySelectorAll('.faq-tab').forEach((b) => {
      b.addEventListener('click', () => {
        state.filter = b.dataset.filter;
        tabsEl.querySelectorAll('.faq-tab').forEach((x) => x.classList.remove('active'));
        b.classList.add('active');
        renderFaqs();
      });
    });
  }

  // ==========================================================
  // 3. Render FAQ accordion
  // ==========================================================
  function renderFaqs() {
    const list = document.getElementById('faqList');
    const noResults = document.getElementById('faqNoResults');

    // Filter + search
    let items = state.faqs.slice();
    if (state.filter !== 'all') {
      items = items.filter((f) => (f.category || 'general') === state.filter);
    }
    if (state.search) {
      const s = state.search.toLowerCase();
      items = items.filter((f) =>
        (f.question || '').toLowerCase().includes(s) ||
        (f.answer || '').toLowerCase().includes(s)
      );
    }

    if (items.length === 0) {
      list.innerHTML = '';
      noResults.style.display = 'block';
      return;
    }

    noResults.style.display = 'none';

    list.innerHTML = items.map((f, i) => {
      const catLabel = CATEGORY_LABELS[f.category] || '';
      const catBadge = catLabel ? `<span class="faq-cat-badge">${catLabel}</span>` : '';
      return `
        <div class="faq-item" data-id="${f.id}">
          <button class="faq-question" aria-expanded="false">
            <span class="faq-q-text">${escapeHtml(f.question || '')}${catBadge}</span>
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-inner">${escapeHtml(f.answer || '')}</div>
          </div>
        </div>
      `;
    }).join('');

    // Bind toggle
    list.querySelectorAll('.faq-item').forEach((item) => {
      const btn = item.querySelector('.faq-question');
      const ans = item.querySelector('.faq-answer');
      const inner = item.querySelector('.faq-answer-inner');

      btn.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');

        // Funga wote (accordion style — kimoja tu wazi)
        list.querySelectorAll('.faq-item').forEach((x) => {
          x.classList.remove('open');
          x.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
          x.querySelector('.faq-answer').style.maxHeight = null;
        });

        // Fungua hii kama ilikuwa imefungwa
        if (!isOpen) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          ans.style.maxHeight = inner.scrollHeight + 40 + 'px';
        }
      });
    });
  }

  // ==========================================================
  // 4. Search (debounced)
  // ==========================================================
  function bindSearch() {
    const input = document.getElementById('faqSearch');
    let timer;
    input.addEventListener('input', (e) => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        state.search = e.target.value.trim();
        renderFaqs();
      }, 200);
    });
  }

  // ==========================================================
  // 5. Helpers
  // ==========================================================
  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  // ==========================================================
  // 6. Boot
  // ==========================================================
  function boot() {
    bindSearch();
    loadFaqs();
  }

  if (window.fs && window.db) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
