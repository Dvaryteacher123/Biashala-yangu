<!-- ==========================================================
     JAVASCRIPT YA BLOG — Firestore: blog_posts
     Document structure:
       title, slug, excerpt, content (markdown-like),
       coverImage, category, tags: [...],
       author: { name, photo },
       publishedAt: Timestamp,
       status: "published" | "draft"
     ========================================================== -->
<script type="module">

  const PAGE_SIZE = 6;
  const fallbackImg = 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22600%22 height=%22400%22><rect fill=%22%23eee%22 width=%22600%22 height=%22400%22/><text x=%22300%22 y=%22210%22 font-size=%2220%22 fill=%22%23999%22 text-anchor=%22middle%22>Hakuna picha</text></svg>';

  // State
  const state = {
    allPosts: [],
    filtered: [],
    shown: PAGE_SIZE,
    search: ''
  };

  // ==========================================================
  // Helpers
  // ==========================================================
  function fmtDate(ts) {
    if (!ts) return '';
    let d = ts;
    if (typeof ts === 'object' && ts.seconds) d = new Date(ts.seconds * 1000);
    else if (typeof ts === 'string') d = new Date(ts);
    if (isNaN(d)) return '';
    return d.toLocaleDateString('sw-TZ', {
      day: 'numeric', month: 'long', year: 'numeric'
    });
  }

  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  // Markdown ndogo (kwa content)
  function parseContent(text) {
    if (!text) return '<p>Hakuna maudhui.</p>';
    return text.split('\n\n').map((p) => {
      const t = p.trim();
      if (!t) return '';

      // Headings
      if (t.startsWith('### ')) return `<h3>${escapeHtml(t.slice(4))}</h3>`;
      if (t.startsWith('## '))  return `<h2>${escapeHtml(t.slice(3))}</h2>`;
      if (t.startsWith('# '))   return `<h2>${escapeHtml(t.slice(2))}</h2>`;

      // Blockquote
      if (t.startsWith('> ')) {
        return `<blockquote>${escapeHtml(t.slice(2)).replace(/\n/g, '<br>')}</blockquote>`;
      }

      // Bullets
      const lines = t.split('\n');
      if (lines.every((l) => l.trim().startsWith('- '))) {
        return `<ul>${lines.map((l) => `<li>${escapeHtml(l.trim().slice(2))}</li>`).join('')}</ul>`;
      }
      if (lines.every((l) => /^\d+\.\s/.test(l.trim()))) {
        return `<ol>${lines.map((l) => `<li>${escapeHtml(l.trim().replace(/^\d+\.\s/, ''))}</li>`).join('')}</ol>`;
      }

      // Paragraph (ruhusu **bold** na [link](url))
      let html = escapeHtml(t).replace(/\n/g, '<br>');
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      html = html.replace(/\[(.+?)\]\((https?:\/\/[^\)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
      return `<p>${html}</p>`;
    }).join('');
  }

  function postCardHTML(p) {
    const cover = p.coverImage || fallbackImg;
    const date = fmtDate(p.publishedAt || p.createdAt);
    const authorName = p.author?.name || '';
    const authorPhoto = p.author?.photo || '';
    const initial = authorName.charAt(0).toUpperCase() || '?';
    const avatarStyle = authorPhoto ? `style="background-image:url('${authorPhoto}')"` : '';

    return `
      <a href="/blog?id=${p.id}" class="post-card">
        <div class="pc-cover">
          <img src="${cover}" alt="${escapeHtml(p.title || '')}" loading="lazy" />
        </div>
        <div class="pc-body">
          <div class="pc-meta">
            ${p.category ? `<span class="pc-cat">${escapeHtml(p.category)}</span>` : ''}
            ${date ? `<span class="pc-date">${date}</span>` : ''}
          </div>
          <h3 class="pc-title">${escapeHtml(p.title || 'Bila jina')}</h3>
          <p class="pc-excerpt">${escapeHtml(p.excerpt || '')}</p>
          <div class="pc-footer">
            <div class="pc-author">
              <div class="pc-author-avatar" ${avatarStyle}>${authorPhoto ? '' : initial}</div>
              <span>${escapeHtml(authorName)}</span>
            </div>
            <span class="pc-read">Soma →</span>
          </div>
        </div>
      </a>
    `;
  }

  // ==========================================================
  // 1. Pakia posts zote (zilizochapishwa tu)
  // ==========================================================
  async function loadPosts() {
    const loading = document.getElementById('blogLoading');
    const list    = document.getElementById('blogList');

    try {
      const { collection, query, where, getDocs, orderBy } = window.fs;

      // Jaribu where status + orderBy; fallback bila
      let snap;
      try {
        snap = await getDocs(query(
          collection(window.db, 'blog_posts'),
          where('status', '==', 'published'),
          orderBy('publishedAt', 'desc')
        ));
      } catch {
        try {
          snap = await getDocs(query(
            collection(window.db, 'blog_posts'),
            where('status', '==', 'published')
          ));
        } catch {
          snap = await getDocs(collection(window.db, 'blog_posts'));
        }
      }

      state.allPosts = snap.docs.map((d) => ({ id: d.id, ...d.data() }));

      // Filter: status published (kama fallback ilirudi zote)
      state.allPosts = state.allPosts.filter((p) => !p.status || p.status === 'published');

      // Sort: publishedAt desc
      state.allPosts.sort((a, b) => {
        const ta = (a.publishedAt?.seconds || a.createdAt?.seconds || 0);
        const tb = (b.publishedAt?.seconds || b.createdAt?.seconds || 0);
        return tb - ta;
      });

      loading.style.display = 'none';
      list.style.display = 'block';

      if (state.allPosts.length === 0) {
        document.getElementById('blogEmpty').style.display = 'block';
        return;
      }

      applySearchAndRender();

    } catch (err) {
      console.error('Blog load error:', err);
      loading.style.display = 'none';
      list.style.display = 'block';
      document.getElementById('blogEmpty').style.display = 'block';
    }
  }

  // ==========================================================
  // 2. Search + Render list
  // ==========================================================
  function applySearchAndRender() {
    const s = state.search.toLowerCase();
    state.filtered = state.allPosts.filter((p) => {
      if (!s) return true;
      return (p.title || '').toLowerCase().includes(s) ||
             (p.excerpt || '').toLowerCase().includes(s) ||
             (p.category || '').toLowerCase().includes(s);
    });

    renderList();
  }

  function renderList() {
    const grid = document.getElementById('blogGrid');
    const empty = document.getElementById('blogEmpty');
    const noResults = document.getElementById('blogNoResults');
    const loadMoreWrap = document.getElementById('loadMoreWrap');

    // No results kwa search
    if (state.filtered.length === 0) {
      grid.style.display = 'none';
      loadMoreWrap.style.display = 'none';
      if (state.search) {
        noResults.style.display = 'block';
        empty.style.display = 'none';
      } else {
        empty.style.display = 'block';
        noResults.style.display = 'none';
      }
      return;
    }

    empty.style.display = 'none';
    noResults.style.display = 'none';

    const visible = state.filtered.slice(0, state.shown);
    grid.innerHTML = visible.map(postCardHTML).join('');
    grid.style.display = 'grid';

    // Load more
    if (state.filtered.length > state.shown) {
      loadMoreWrap.style.display = 'block';
    } else {
      loadMoreWrap.style.display = 'none';
    }
  }

  function bindLoadMore() {
    document.getElementById('loadMoreBtn').addEventListener('click', () => {
      state.shown += PAGE_SIZE;
      renderList();
    });
  }

  // ==========================================================
  // 3. Pakia post moja (?id=xxx)
  // ==========================================================
  async function loadSingle(id) {
    const loading = document.getElementById('blogLoading');
    const list    = document.getElementById('blogList');
    const single  = document.getElementById('blogSingle');
    const nf      = document.getElementById('blogNotFound');

    try {
      const { doc, getDoc } = window.fs;
      const snap = await getDoc(doc(window.db, 'blog_posts', id));

      loading.style.display = 'none';

      if (!snap.exists()) {
        nf.style.display = 'block';
        return;
      }

      const p = { id: snap.id, ...snap.data() };

      // Update page title
      if (p.title) document.title = `${p.title} | Blog`;

      // Meta
      if (p.category) {
        const el = document.getElementById('postCat');
        el.textContent = p.category;
        el.style.display = 'inline-block';
      }
      const dateStr = fmtDate(p.publishedAt || p.createdAt);
      if (dateStr) document.getElementById('postDate').textContent = dateStr;

      // Title + excerpt
      document.getElementById('postTitle').textContent = p.title || 'Bila jina';
      if (p.excerpt) {
        document.getElementById('postExcerpt').textContent = p.excerpt;
        document.getElementById('postExcerpt').style.display = 'block';
      }

      // Author
      if (p.author?.name) {
        const avatarEl = document.getElementById('authorAvatar');
        const initial = p.author.name.charAt(0).toUpperCase();
        if (p.author.photo) {
          avatarEl.style.backgroundImage = `url('${p.author.photo}')`;
          avatarEl.textContent = '';
        } else {
          avatarEl.textContent = initial;
        }
        document.getElementById('authorName').textContent = p.author.name;
        document.getElementById('postAuthor').style.display = 'flex';
      }

      // Cover
      if (p.coverImage) {
        document.getElementById('postCoverImg').src = p.coverImage;
        document.getElementById('postCoverImg').alt = p.title || '';
        document.getElementById('postCover').style.display = 'block';
      }

      // Content
      document.getElementById('postContent').innerHTML = parseContent(p.content || '');

      // Tags
      if (Array.isArray(p.tags) && p.tags.length) {
        document.getElementById('postTags').innerHTML = p.tags.map((t) =>
          `<span class="post-tag">#${escapeHtml(t)}</span>`
        ).join('');
        document.getElementById('postTags').style.display = 'flex';
      }

      // Bind share
      bindShare(p);

      // Related posts (same category)
      if (p.category) loadRelated(p);

      single.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'instant' });

    } catch (err) {
      console.error('Blog single error:', err);
      loading.style.display = 'none';
      nf.style.display = 'block';
    }
  }

  // ==========================================================
  // 4. Share
  // ==========================================================
  function bindShare(post) {
    const url = encodeURIComponent(location.href);
    const title = encodeURIComponent(post.title || '');

    document.querySelectorAll('.share-btn').forEach((b) => {
      b.addEventListener('click', () => {
        const type = b.dataset.share;
        if (type === 'facebook') {
          window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank', 'width=600,height=500');
        } else if (type === 'twitter') {
          window.open(`https://twitter.com/intent/tweet?url=${url}&text=${title}`, '_blank', 'width=600,height=500');
        } else if (type === 'whatsapp') {
          window.open(`https://wa.me/?text=${title}%20${url}`, '_blank');
        } else if (type === 'copy') {
          navigator.clipboard.writeText(location.href).then(() => {
            b.textContent = '✓';
            setTimeout(() => { b.textContent = '🔗'; }, 1500);
          });
        }
      });
    });
  }

  // ==========================================================
  // 5. Related posts
  // ==========================================================
  async function loadRelated(post) {
    try {
      const { collection, query, where, limit, getDocs } = window.fs;
      const snap = await getDocs(query(
        collection(window.db, 'blog_posts'),
        where('category', '==', post.category),
        limit(6)
      ));

      const items = snap.docs
        .map((d) => ({ id: d.id, ...d.data() }))
        .filter((p) => p.id !== post.id && (!p.status || p.status === 'published'))
        .slice(0, 3);

      if (items.length === 0) return;

      document.getElementById('relatedGrid').innerHTML = items.map(postCardHTML).join('');
      document.getElementById('relatedSection').style.display = 'block';
    } catch (err) {
      // Inaweza kuhitaji composite index — haina shida kama inashindikana
      console.warn('Related posts:', err);
    }
  }

  // ==========================================================
  // 6. Search binding
  // ==========================================================
  function bindSearch() {
    const input = document.getElementById('blogSearchInput');
    if (!input) return;
    let timer;
    input.addEventListener('input', (e) => {
      clearTimeout(timer);
      timer = setTimeout(() => {
        state.search = e.target.value.trim();
        state.shown = PAGE_SIZE;
        applySearchAndRender();
      }, 220);
    });
  }

  // ==========================================================
  // 7. Boot
  // ==========================================================
  function boot() {
    const urlId = new URLSearchParams(location.search).get('id');

    if (urlId) {
      loadSingle(urlId);
    } else {
      bindSearch();
      bindLoadMore();
      loadPosts();
    }
  }

  if (window.fs && window.db) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
