<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     BLOG PAGE — Firestore: blog_posts collection
     ?id=xxx → post moja kamili
     ========================================================== -->

<main class="blog-page">

  <!-- ============ Hero ============ -->
  <section class="blog-hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-badge">📰 Blog</span>
        <h1 id="blogHeroTitle">Habari na Makala</h1>
        <p class="hero-sub">
          Habari, vidokezo, na makala kuhusu mitindo, nguo na duka letu.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ Loading ============ -->
  <div id="blogLoading" class="container" style="padding:50px 0;">
    <div class="loading">
      <div class="spinner"></div> Inapakia...
    </div>
  </div>

  <!-- ============ Not found (post haipo) ============ -->
  <div id="blogNotFound" class="container" style="display:none;padding:50px 0;">
    <div class="empty-state">
      <h3>Post haipatikani</h3>
      <p>Post uliyoitafuta haipo au imeondolewa.</p>
      <a href="/blog" class="btn btn-primary" style="margin-top:14px;">Rudi kwenye Blog</a>
    </div>
  </div>

  <!-- ============ LIST VIEW ============ -->
  <div id="blogList" style="display:none;">
    <div class="container">

      <!-- Search -->
      <div class="blog-search">
        <input
          type="text"
          id="blogSearchInput"
          placeholder="🔍 Tafuta makala..."
          autocomplete="off"
        />
      </div>

      <!-- Empty -->
      <div id="blogEmpty" class="empty-state" style="display:none;">
        <h3>Hakuna posts bado</h3>
        <p>Makala zitaonekana hapa zikiwekwa na msimamizi.</p>
      </div>

      <!-- No results after search -->
      <div id="blogNoResults" class="empty-state" style="display:none;">
        <h3>Hakuna matokeo</h3>
        <p>Hakuna makala inayolingana na utafutaji wako.</p>
      </div>

      <!-- Posts grid -->
      <div id="blogGrid" class="blog-grid" style="display:none;"></div>

      <!-- Load more -->
      <div class="load-more-wrap" id="loadMoreWrap" style="display:none;">
        <button class="btn btn-outline" id="loadMoreBtn">Ona Zaidi</button>
      </div>

    </div>
  </div>

  <!-- ============ SINGLE POST VIEW ============ -->
  <div id="blogSingle" style="display:none;">
    <div class="container narrow">

      <!-- Back -->
      <a href="/blog" class="back-link">← Rudi kwenye Blog</a>

      <!-- Post header -->
      <header class="post-header">
        <div class="post-meta">
          <span class="post-cat" id="postCat" style="display:none;"></span>
          <span class="post-date" id="postDate"></span>
        </div>
        <h1 id="postTitle"></h1>
        <p class="post-excerpt" id="postExcerpt" style="display:none;"></p>
        <div class="post-author" id="postAuthor" style="display:none;">
          <div class="author-avatar" id="authorAvatar">?</div>
          <div>
            <div class="author-name" id="authorName"></div>
            <div class="author-label">Mwandishi</div>
          </div>
        </div>
      </header>

      <!-- Cover -->
      <div class="post-cover" id="postCover" style="display:none;">
        <img id="postCoverImg" src="" alt="" />
      </div>

      <!-- Content -->
      <article class="post-content" id="postContent"></article>

      <!-- Tags -->
      <div class="post-tags" id="postTags" style="display:none;"></div>

      <!-- Share -->
      <div class="post-share">
        <span>Tuma kwa marafiki:</span>
        <button class="share-btn" data-share="facebook" title="Facebook">📘</button>
        <button class="share-btn" data-share="twitter" title="Twitter">🐦</button>
        <button class="share-btn" data-share="whatsapp" title="WhatsApp">💬</button>
        <button class="share-btn" data-share="copy" title="Copy link">🔗</button>
      </div>

      <!-- Related posts -->
      <section class="related-posts" id="relatedSection" style="display:none;">
        <h2>Makala Zinazofanana</h2>
        <div class="blog-grid" id="relatedGrid"></div>
      </section>

    </div>
  </div>

</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA BLOG PAGE
     ========================================================== -->
<style>
  .blog-page { padding-bottom: 40px; min-height: 60vh; }

