    display: inline-block;
    background: #e63946;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .blog-hero h1 {
    font-size: 34px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .hero-sub {
    color: #ccc;
    font-size: 16px;
    line-height: 1.6;
  }

  .container.narrow { max-width: 780px; }

  /* ---------- Search ---------- */
  .blog-search {
    max-width: 480px;
    margin: 0 auto 30px;
  }
