<%- include('../partials/header', { title, description }) %>
<%- include('../partials/navbar') %>

<!-- ==========================================================
     SHIPPING PAGE — Firestore: pages/shipping + settings/site
     ========================================================== -->

<main class="ship-page">

  <!-- ============ Hero ============ -->
  <section class="ship-hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-badge">🚚 Usafirishaji</span>
        <h1 id="shipTitle">Taratibu za Usafirishaji</h1>
        <p id="shipIntro" class="hero-sub">Inapakia...</p>
      </div>
    </div>
  </section>

  <!-- ============ Loading ============ -->
  <div id="shipLoading" class="container" style="padding:40px 0;">
    <div class="loading">
      <div class="spinner"></div> Inapakia maudhui...
    </div>
  </div>

  <!-- ============ Empty ============ -->
  <div id="shipEmpty" class="container" style="display:none;padding:40px 0;">
    <div class="empty-state">
      <h3>Maudhui yataonekana hapa</h3>
      <p>
        Maelezo ya usafirishaji bado hayajawekwa. Msimamizi anaweza kuyaweka
        kupitia Firestore collection <code>pages/shipping</code>.
      </p>
      <a href="/contact" class="btn btn-primary" style="margin-top:14px;">Wasiliana Nasi</a>
    </div>
  </div>

  <!-- ============ Content ============ -->
  <div id="shipContent" style="display:none;">
    <div class="container narrow">

      <!-- Highlights -->
      <section class="highlights" id="highlightsSection" style="display:none;">
        <div class="highlights-grid" id="highlightsGrid"></div>
      </section>

      <!-- Body (long text) -->
      <section class="ship-body" id="bodySection" style="display:none;">
        <div class="prose" id="bodyText"></div>
      </section>

      <!-- Rates table -->
      <section class="rates-section" id="ratesSection" style="display:none;">
        <h2>📊 Bei za Usafirishaji</h2>
        <div class="rates-table-wrap">
          <table class="rates-table">
            <thead>
              <tr>
                <th>Eneo</th>
                <th>Muda</th>
                <th>Bei (TSh)</th>
              </tr>
            </thead>
            <tbody id="ratesBody"></tbody>
          </table>
        </div>
        <p class="rates-note" id="ratesNote" style="display:none;"></p>
      </section>

      <!-- Steps -->
      <section class="steps-section" id="stepsSection" style="display:none;">
        <h2>🛠️ Jinsi Inavyofanya Kazi</h2>
        <div class="steps-list" id="stepsList"></div>
      </section>

      <!-- Contact CTA -->
      <section class="ship-cta">
        <h3>Una swali kuhusu usafirishaji?</h3>
        <p>Wasiliana nasi na tutakujibu haraka.</p>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Wasiliana Nasi</a>
          <a href="/shop" class="btn btn-outline">Nenda Dukani</a>
        </div>
      </section>

    </div>
  </div>

</main>

<%- include('../partials/footer') %>

<!-- ==========================================================
     CSS YA SHIPPING PAGE
     ========================================================== -->
<style>
  .ship-page { padding-bottom: 40px; }

  /* ---------- Hero ---------- */
  .ship-hero {
    background: linear-gradient(135deg, #111 0%, #2a2a2a 100%);
    color: #fff;
    padding: 55px 0;
    text-align: center;
  }
  .hero-inner { max-width: 700px; margin: 0 auto; }
  .hero-badge {
    display: inline-block;
    background: #e63946;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 20px;
    margin-bottom: 14px;
  }
  .ship-hero h1 {
    font-size: 32px;
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .hero-sub {
    color: #ccc;
    font-size: 16px;
    line-height: 1.6;
  }

  /* ---------- Content wrapper ---------- */
  .container.narrow { max-width: 860px; }

  /* ---------- Highlights ---------- */
  .highlights { padding: 30px 0 10px; }
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
  }
  .highlight-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 20px;
    text-align: center;
  }
  .hl-icon {
    font-size: 28px;
    margin-bottom: 8px;
  }
  .hl-title {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }
  .hl-text {
    font-size: 13px;
    color: #666;
    line-height: 1.5;
  }

  /* ---------- Body prose ---------- */
  .ship-body { padding: 20px 0 10px; }
  .prose {
    color: #444;
    font-size: 15px;
    line-height: 1.8;
  }
  .prose p { margin-bottom: 14px; }
  .prose h3 {
    font-size: 18px;
    font-weight: 800;
    color: #111;
    margin: 22px 0 10px;
  }
  .prose ul,
  .prose ol {
    padding-left: 22px;
    margin-bottom: 14px;
  }
  .prose li { margin-bottom: 6px; }

  /* ---------- Rates table ---------- */
  .rates-section { padding: 30px 0 10px; }
  .rates-section h2 {
    font-size: 22px;
    font-weight: 800;
    color: #111;
    margin-bottom: 16px;
  }
  .rates-table-wrap {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    overflow: hidden;
  }
  .rates-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  .rates-table thead {
    background: #f7f7f9;
  }
  .rates-table th {
    text-align: left;
    padding: 14px 18px;
    font-size: 12px;
    font-weight: 700;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid #eee;
  }
  .rates-table td {
    padding: 14px 18px;
    color: #333;
    border-bottom: 1px solid #f4f4f6;
  }
  .rates-table tbody tr:last-child td { border-bottom: none; }
  .rates-table tbody tr:hover { background: #fafafc; }
  .rates-table td:nth-child(3) {
    font-weight: 700;
    color: #e63946;
  }
  .rates-note {
    font-size: 13px;
    color: #888;
    margin-top: 10px;
    line-height: 1.5;
  }

  /* ---------- Steps ---------- */
  .steps-section { padding: 30px 0 10px; }
  .steps-section h2 {
    font-size: 22px;
    font-weight: 800;
    color: #111;
    margin-bottom: 18px;
  }
  .steps-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .step-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    padding: 18px 20px;
  }
  .step-num {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #111;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    flex-shrink: 0;
  }
  .step-body { flex: 1; min-width: 0; }
  .step-title {
    font-size: 15px;
    font-weight: 700;
    color: #111;
    margin-bottom: 4px;
  }
  .step-text {
    font-size: 14px;
    color: #555;
    line-height: 1.6;
  }

  /* ---------- CTA ---------- */
  .ship-cta {
    margin: 50px 0 0;
    background: linear-gradient(135deg, #e63946 0%, #c53030 100%);
    color: #fff;
    border-radius: 14px;
    padding: 34px 24px;
    text-align: center;
  }
  .ship-cta h3 {
    font-size: 20px;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .ship-cta p {
    color: #ffe5e7;
    font-size: 14px;
    margin-bottom: 18px;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ship-cta .btn-primary {
    background: #fff;
    color: #e63946;
  }
  .ship-cta .btn-primary:hover {
    background: #ffe5e7;
    color: #111;
  }
  .ship-cta .btn-outline {
    border-color: #fff;
    color: #fff;
  }
  .ship-cta .btn-outline:hover {
    background: #fff;
    color: #e63946;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 600px) {
    .ship-hero h1 { font-size: 24px; }
    .rates-table th,
    .rates-table td { padding: 12px 12px; font-size: 13px; }
    .step-item { padding: 16px; }
  }
</style>

<!-- ==========================================================
     JAVASCRIPT YA SHIPPING — Firestore: pages/shipping
     Document structure inayotarajiwa:
       title, intro,
       highlights: [{ icon, title, text }],
       body: "paragraph 1\n\nparagraph 2...",
       rates: [{ zone, time, price }],
       ratesNote,
       steps: [{ title, text }]
     Kila kitu ni hiari.
     ========================================================== -->
<script type="module">

  const fmt = (n) => `TSh ${Number(n || 0).toLocaleString()}`;

  async function loadShipping() {
    const loading = document.getElementById('shipLoading');
    const empty   = document.getElementById('shipEmpty');
    const content = document.getElementById('shipContent');

    try {
      const { doc, getDoc } = window.fs;
      const snap = await getDoc(doc(window.db, 'pages', 'shipping'));

      loading.style.display = 'none';

      if (!snap.exists()) {
        empty.style.display = 'block';
        return;
      }

      const data = snap.data();
      render(data);
      content.style.display = 'block';

    } catch (err) {
      console.error('Shipping error:', err);
      loading.style.display = 'none';
      empty.style.display = 'block';
    }
  }

  function render(data) {
    // Title + intro
    if (data.title) document.getElementById('shipTitle').textContent = data.title;
    if (data.intro) document.getElementById('shipIntro').textContent = data.intro;
    else document.getElementById('shipIntro').style.display = 'none';

    // Highlights
    if (Array.isArray(data.highlights) && data.highlights.length) {
      document.getElementById('highlightsSection').style.display = 'block';
      document.getElementById('highlightsGrid').innerHTML = data.highlights.map((h) => `
        <div class="highlight-card">
          ${h.icon ? `<div class="hl-icon">${escapeHtml(h.icon)}</div>` : ''}
          <div class="hl-title">${escapeHtml(h.title || '')}</div>
          <div class="hl-text">${escapeHtml(h.text || '')}</div>
        </div>
      `).join('');
    }

    // Body
    if (data.body) {
      document.getElementById('bodySection').style.display = 'block';
      document.getElementById('bodyText').innerHTML = data.body
        .split('\n\n')
        .map((p) => {
          const t = p.trim();
          if (!t) return '';
          // Ruhusu headings rahisi: ## Title
          if (t.startsWith('## ')) {
            return `<h3>${escapeHtml(t.slice(3))}</h3>`;
          }
          // Ruhusu bullet list: lines zinazoanza na "- "
          const lines = t.split('\n');
          if (lines.every((l) => l.trim().startsWith('- '))) {
            return `<ul>${lines.map((l) => `<li>${escapeHtml(l.trim().slice(2))}</li>`).join('')}</ul>`;
          }
          return `<p>${escapeHtml(t).replace(/\n/g, '<br>')}</p>`;
        })
        .join('');
    }

    // Rates table
    if (Array.isArray(data.rates) && data.rates.length) {
      document.getElementById('ratesSection').style.display = 'block';
      document.getElementById('ratesBody').innerHTML = data.rates.map((r) => {
        const price = (typeof r.price === 'number')
          ? fmt(r.price)
          : escapeHtml(r.price || '—');
        return `
          <tr>
            <td>${escapeHtml(r.zone || '')}</td>
            <td>${escapeHtml(r.time || '')}</td>
            <td>${price}</td>
          </tr>
        `;
      }).join('');

      if (data.ratesNote) {
        document.getElementById('ratesNote').style.display = 'block';
        document.getElementById('ratesNote').textContent = data.ratesNote;
      }
    }

    // Steps
    if (Array.isArray(data.steps) && data.steps.length) {
      document.getElementById('stepsSection').style.display = 'block';
      document.getElementById('stepsList').innerHTML = data.steps.map((s, i) => `
        <div class="step-item">
          <div class="step-num">${i + 1}</div>
          <div class="step-body">
            <div class="step-title">${escapeHtml(s.title || '')}</div>
            <div class="step-text">${escapeHtml(s.text || '')}</div>
          </div>
        </div>
      `).join('');
    }
  }

  function escapeHtml(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function boot() {
    loadShipping();
  }

  if (window.fs && window.db) {
    boot();
  } else {
    window.addEventListener('firebase-ready', boot, { once: true });
  }
</script>
